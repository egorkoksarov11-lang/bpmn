<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_ClientFunds" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:collaboration id="Collaboration_Process_ClientFunds">
    <bpmn:participant id="Participant_Process_ClientFunds" name="Прием денежных средств от клиента и формирование обязательства по клиентской операции" processRef="Process_ClientFunds"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_ClientFunds" name="Прием денежных средств от клиента и формирование обязательства по клиентской операции" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_ClientFunds">
      <bpmn:lane id="L1F" name="Руководитель финансового блока">
        <bpmn:flowNodeRef>R1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gfinish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Erej</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L1O" name="Операционист">
        <bpmn:flowNodeRef>O1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L1C" name="Клиентский менеджер">
        <bpmn:flowNodeRef>C1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Crequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gfull</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gcheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CdeniedInit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CallCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GresInit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EinitDenied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cchg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gmatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gnew</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cnewcheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gnewok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CallCheck3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GresNew</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CallCheck2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GresExec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gcur</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cnotify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CblockedDoc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L1A" name="Уполномоченное лицо">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gappr</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Поручение о работе с клиентом">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="C1" name="Проверить полноту поручения">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A1" name="Передать поручение и условия операции">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataObjectReference id="D_OrderInitial" name="Поручение о работе с клиентом" dataObjectRef="DO_Order"/>
    <bpmn:task id="A2" name="Предоставить недостающие сведения">
      <bpmn:incoming>f4a</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Crequest" name="Запросить недостающие сведения у уполномоченного лица">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f4a</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gfull" name="Данные полные?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="C2" name="Проверить допуск каждого юридического лица из поручения">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:property id="Property_01qtq5e" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DataInputAssociation_0fcnwq1">
        <bpmn:sourceRef>D_OrderCompare</bpmn:sourceRef>
        <bpmn:targetRef>Property_01qtq5e</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:dataObjectReference id="D_OrderCompare" name="Исходное поручение" dataObjectRef="DO_Order"/>
    <bpmn:exclusiveGateway id="Gcheck" name="По всем ЮЛ есть действующий допуск?">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:outgoing>fnoInitial</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="CdeniedInit" name="Сообщить о недопуске уполномоченному лицу; не планировать">
      <bpmn:incoming>fresInitNo</bpmn:incoming>
      <bpmn:incoming>fnoInitial</bpmn:incoming>
      <bpmn:outgoing>fendInit</bpmn:outgoing>
    </bpmn:task>
    <bpmn:callActivity id="CallCheck" name="Проверка юридического лица" calledElement="Process_LegalEntityCheck">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>fresInitIn</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_194cdhw">
        <bpmn:targetRef>D_CheckAtC2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="GresInit" name="Результат допускает?">
      <bpmn:incoming>fresInitIn</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:outgoing>fresInitNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:dataObjectReference id="D_CheckAtC2" name="Результат проверки" dataObjectRef="DO_Check"/>
    <bpmn:endEvent id="EinitDenied" name="Планирование прекращено: участник не допущен">
      <bpmn:incoming>fendInit</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="C3" name="Сформировать план: приход + связанный расход">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataObjectReference id="D_OrderAtPlan" name="Исходное поручение" dataObjectRef="DO_Order"/>
    <bpmn:dataObjectReference id="D_WorkPlan" name="Рабочий файл: план" dataObjectRef="DO_Work"/>
    <bpmn:task id="F1" name="Направить плановый Рабочий файл руководителю финансового блока">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="C4" name="Сопоставить с планом и отразить фактическое поступление">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataObjectReference id="D_BankManager" name="Банковская выписка" dataObjectRef="DO_Bank"/>
    <bpmn:task id="C5" name="Получить конкретное поручение клиента и сопоставить с исходным">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataObjectReference id="D_OrderAtExecution" name="Исходное поручение" dataObjectRef="DO_Order"/>
    <bpmn:task id="Cchg" name="Передать отклонения уполномоченному лицу">
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gmatch" name="Соответствует поручению?">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
      <bpmn:outgoing>f21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A3" name="Рассмотреть изменение условий / участника">
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gappr" name="Изменение согласовано?">
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
      <bpmn:outgoing>f25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="C6" name="Проверить допуск каждого участника на дату исполнения">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:incoming>f29</bpmn:incoming>
      <bpmn:incoming>fnewb</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataObjectReference id="D_ClientOrder" name="Поручение клиента / счет / выдача" dataObjectRef="DO_Client"/>
    <bpmn:dataObject id="DO_Client" name="Конкретное поручение клиента (счет/реквизиты или данные выдачи)"/>
    <bpmn:task id="C9" name="Зафиксировать согласованные изменения в поручении">
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:outgoing>f26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gnew" name="Есть новый участник?">
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:outgoing>f27</bpmn:outgoing>
      <bpmn:outgoing>f29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:dataObjectReference id="D_OrderChange" name="Измененное поручение" dataObjectRef="DO_Order"/>
    <bpmn:dataObject id="DO_Order" name="Поручение о работе с клиентом"/>
    <bpmn:task id="Cnewcheck" name="Проверить действующий допуск нового участника">
      <bpmn:incoming>f27</bpmn:incoming>
      <bpmn:incoming>f28</bpmn:incoming>
      <bpmn:outgoing>fnewa</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gnewok" name="Есть действующий допуск?" gatewayDirection="Diverging">
      <bpmn:incoming>fnewa</bpmn:incoming>
      <bpmn:outgoing>fnewb</bpmn:outgoing>
      <bpmn:outgoing>fnewc</bpmn:outgoing>
      <bpmn:outgoing>fnoNew</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="CallCheck3" name="Проверка нового участника" calledElement="Process_LegalEntityCheck">
      <bpmn:incoming>fnewc</bpmn:incoming>
      <bpmn:outgoing>fresNewIn</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1n42ykp">
        <bpmn:targetRef>D_CheckChanged</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="GresNew" name="Результат допускает?">
      <bpmn:incoming>fresNewIn</bpmn:incoming>
      <bpmn:outgoing>f28</bpmn:outgoing>
      <bpmn:outgoing>fresNewNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:dataObjectReference id="D_CheckAtC6" name="Результат проверки" dataObjectRef="DO_Check"/>
    <bpmn:callActivity id="CallCheck2" name="Проверка юридического лица" calledElement="Process_LegalEntityCheck">
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>fresExecIn</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="GresExec" name="Результат допускает?">
      <bpmn:incoming>fresExecIn</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
      <bpmn:outgoing>fresExecNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gcur" name="На дату исполнения по всем ЮЛ есть допуск?">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
      <bpmn:outgoing>f20</bpmn:outgoing>
      <bpmn:outgoing>fnoExec</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Cnotify" name="Сообщить клиенту и уполномоченному лицу о невозможности исполнения на предложенных условиях">
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:incoming>fresExecNo</bpmn:incoming>
      <bpmn:incoming>fnoExec</bpmn:incoming>
      <bpmn:incoming>fresNewNo</bpmn:incoming>
      <bpmn:incoming>fnoNew</bpmn:incoming>
      <bpmn:outgoing>f24b</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataObjectReference id="D_CheckChanged" name="Результат проверки нового ЮЛ" dataObjectRef="DO_Check"/>
    <bpmn:dataObjectReference id="D_CheckExecute" name="Результат проверки" dataObjectRef="DO_Check"/>
    <bpmn:dataObject id="DO_Check" name="Действующий результат проверки юридического лица"/>
    <bpmn:task id="C7" name="Актуализировать параметры связанного расхода">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f30</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="F2" name="Направить обновленный Рабочий файл руководителю финансового блока">
      <bpmn:incoming>f30</bpmn:incoming>
      <bpmn:incoming>fblockedToFin</bpmn:incoming>
      <bpmn:outgoing>f31</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="CblockedDoc" name="Сохранить факт прихода; указать невозможность расхода в Рабочем файле">
      <bpmn:incoming>f24b</bpmn:incoming>
      <bpmn:outgoing>fblockedToFin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="O1" name="Сформировать и предоставить банковскую выписку">
      <bpmn:incoming>f12b</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataObjectReference id="D_BankOperator" name="Банковская выписка" dataObjectRef="DO_Bank"/>
    <bpmn:dataObject id="DO_Bank" name="Банковская выписка"/>
    <bpmn:dataStoreReference id="StoreBankClient" name="Банк-клиент" dataStoreRef="DataStoreBank"/>
    <bpmn:sequenceFlow id="f1" sourceRef="S" targetRef="A1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="A1" targetRef="C1"/>
    <bpmn:sequenceFlow id="f5" sourceRef="A2" targetRef="C1"/>
    <bpmn:sequenceFlow id="f3" sourceRef="C1" targetRef="Gfull"/>
    <bpmn:sequenceFlow id="f4a" sourceRef="Crequest" targetRef="A2"/>
    <bpmn:sequenceFlow id="f4" name="Нет" sourceRef="Gfull" targetRef="Crequest"/>
    <bpmn:sequenceFlow id="f6" name="Да" sourceRef="Gfull" targetRef="C2"/>
    <bpmn:sequenceFlow id="f9" name="Допуск" sourceRef="GresInit" targetRef="C2">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">Получен действующий результат проверки, допускающий работу</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f7" sourceRef="C2" targetRef="Gcheck"/>
    <bpmn:sequenceFlow id="f8" name="Нет действующего результата" sourceRef="Gcheck" targetRef="CallCheck">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">Отсутствует действующий результат проверки как минимум одного необходимого юридического лица и отсутствует действующий недопуск</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f10" name="Допуск по всем" sourceRef="Gcheck" targetRef="C3">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">По всем юридическим лицам есть действующий результат проверки, допускающий работу</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fnoInitial" name="Недопуск" sourceRef="Gcheck" targetRef="CdeniedInit">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">Для хотя бы одного юридического лица имеется действующий недопускающий результат проверки</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fresInitNo" name="Недопуск" sourceRef="GresInit" targetRef="CdeniedInit">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">Результат проверки не допускает работу с юридическим лицом</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fendInit" sourceRef="CdeniedInit" targetRef="EinitDenied"/>
    <bpmn:sequenceFlow id="fresInitIn" sourceRef="CallCheck" targetRef="GresInit"/>
    <bpmn:sequenceFlow id="f11" sourceRef="C3" targetRef="F1"/>
    <bpmn:sequenceFlow id="f12" sourceRef="F1" targetRef="R1"/>
    <bpmn:sequenceFlow id="f13" sourceRef="O1" targetRef="C4"/>
    <bpmn:sequenceFlow id="f14" sourceRef="C4" targetRef="C5"/>
    <bpmn:sequenceFlow id="f15" sourceRef="C5" targetRef="Gmatch"/>
    <bpmn:sequenceFlow id="f21" name="Нет" sourceRef="Gmatch" targetRef="Cchg"/>
    <bpmn:sequenceFlow id="f22" sourceRef="Cchg" targetRef="A3"/>
    <bpmn:sequenceFlow id="f16" name="Да" sourceRef="Gmatch" targetRef="C6"/>
    <bpmn:sequenceFlow id="f23" sourceRef="A3" targetRef="Gappr"/>
    <bpmn:sequenceFlow id="f24" name="Нет" sourceRef="Gappr" targetRef="Cnotify"/>
    <bpmn:sequenceFlow id="f25" name="Да" sourceRef="Gappr" targetRef="C9"/>
    <bpmn:sequenceFlow id="f19" name="Допуск" sourceRef="GresExec" targetRef="C6">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">Получен действующий результат, допускающий работу</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f29" name="Нет" sourceRef="Gnew" targetRef="C6"/>
    <bpmn:sequenceFlow id="fnewb" name="Да" sourceRef="Gnewok" targetRef="C6">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">Для нового участника есть действующий результат проверки, допускающий работу</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f17" sourceRef="C6" targetRef="Gcur"/>
    <bpmn:sequenceFlow id="f26" sourceRef="C9" targetRef="Gnew"/>
    <bpmn:sequenceFlow id="f27" name="Да" sourceRef="Gnew" targetRef="Cnewcheck"/>
    <bpmn:sequenceFlow id="f28" name="Допуск" sourceRef="GresNew" targetRef="Cnewcheck">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">Получен действующий результат, допускающий работу с новым участником</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fnewa" sourceRef="Cnewcheck" targetRef="Gnewok"/>
    <bpmn:sequenceFlow id="fnewc" name="Нет результата" sourceRef="Gnewok" targetRef="CallCheck3">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">Отсутствует действующий результат проверки нового участника и отсутствует действующий недопуск</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fnoNew" name="Недопуск" sourceRef="Gnewok" targetRef="Cnotify">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">У нового участника имеется действующий недопускающий результат</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fresNewIn" sourceRef="CallCheck3" targetRef="GresNew"/>
    <bpmn:sequenceFlow id="fresNewNo" name="Недопуск" sourceRef="GresNew" targetRef="Cnotify">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">Получен результат, не допускающий работу с новым участником</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f18" name="Нет действующего результата" sourceRef="Gcur" targetRef="CallCheck2">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">Отсутствует действующий результат хотя бы одного юридического лица и отсутствует действующий недопуск</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fresExecIn" sourceRef="CallCheck2" targetRef="GresExec"/>
    <bpmn:sequenceFlow id="fresExecNo" name="Недопуск" sourceRef="GresExec" targetRef="Cnotify">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">Получен результат проверки, не допускающий работу</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f20" name="Допуск по всем" sourceRef="Gcur" targetRef="C7">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">Для всех участвующих юридических лиц на дату исполнения есть действующий допускающий результат</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fnoExec" name="Недопуск" sourceRef="Gcur" targetRef="Cnotify">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">Имеется действующий результат проверки, не допускающий работу с участником операции</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f24b" sourceRef="Cnotify" targetRef="CblockedDoc"/>
    <bpmn:sequenceFlow id="f30" sourceRef="C7" targetRef="F2"/>
    <bpmn:sequenceFlow id="fblockedToFin" sourceRef="CblockedDoc" targetRef="F2"/>
    <bpmn:sequenceFlow id="f31" sourceRef="F2" targetRef="R2"/>
    <bpmn:sequenceFlow id="f12b" sourceRef="R1" targetRef="O1"/>
    <bpmn:task id="R1" name="Получить плановый Рабочий файл">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f12b</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataObjectReference id="D_WorkPlanFinance" name="Рабочий файл: план" dataObjectRef="DO_Work"/>
    <bpmn:task id="R2" name="Получить обновленный Рабочий файл">
      <bpmn:incoming>f31</bpmn:incoming>
      <bpmn:outgoing>f31b</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataObjectReference id="D_WorkUpdatedFinance" name="Рабочий файл: расход" dataObjectRef="DO_Work"/>
    <bpmn:dataObject id="DO_Work" name="Рабочий файл клиентских операций"/>
    <bpmn:endEvent id="E" name="Актуальные данные переданы финансовому блоку">
      <bpmn:incoming>ffinishYes</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f31b" sourceRef="R2" targetRef="Gfinish"/>
    <bpmn:sequenceFlow id="ffinishYes" name="Да" sourceRef="Gfinish" targetRef="E">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">Есть согласованные параметры расхода и требуемые допуски</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ffinishNo" name="Нет" sourceRef="Gfinish" targetRef="Erej">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">Исполнение на текущих условиях невозможно и отмечено в Рабочем файле</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gfinish" name="Расход согласован и допущен?">
      <bpmn:incoming>f31b</bpmn:incoming>
      <bpmn:outgoing>ffinishYes</bpmn:outgoing>
      <bpmn:outgoing>ffinishNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Erej" name="Факт прихода и неисполненное обязательство переданы">
      <bpmn:incoming>ffinishNo</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:association id="a01" associationDirection="One" sourceRef="A1" targetRef="D_OrderInitial"/>
    <bpmn:association id="a04" associationDirection="One" sourceRef="D_OrderAtPlan" targetRef="C3"/>
