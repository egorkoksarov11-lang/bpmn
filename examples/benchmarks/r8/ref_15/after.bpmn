  <bpmn:process id="Process_1" name="Актуализация сведений воинского учета" isExecutable="false">
    <bpmn:laneSet id="LS">
      <bpmn:lane id="L2" name="Кадровик">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
