      <bpmndi:BPMNShape id="Task_Organize_di" bpmnElement="Task_Organize">
        <dc:Bounds x="510.0" y="290" width="220.0" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Change_di" bpmnElement="Gateway_Change" isMarkerVisible="true">
        <dc:Bounds x="760.0" y="325.0" width="50.0" height="50.0"/>
        <bpmndi:BPMNLabel><dc:Bounds x="581.0" y="421.0" width="220" height="57"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PrepareChange_di" bpmnElement="Task_PrepareChange">
        <dc:Bounds x="170.0" y="520" width="220.0" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ChangeFinancialImpact_di" bpmnElement="Gateway_ChangeFinancialImpact" isMarkerVisible="true">
        <dc:Bounds x="420.0" y="555.0" width="50.0" height="50.0"/>
        <bpmndi:BPMNLabel><dc:Bounds x="237.0" y="476.0" width="176" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ChangeFinanceConfirm_di" bpmnElement="Task_ChangeFinanceConfirm">
        <dc:Bounds x="170.0" y="1370" width="220.0" height="120"/>
