        <dc:Bounds x="30" y="1098" width="1530.0" height="440"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Auth_di" bpmnElement="Lane_Auth" isHorizontal="true">
        <dc:Bounds x="30" y="688" width="1530.0" height="410"/>
      </bpmndi:BPMNShape>
