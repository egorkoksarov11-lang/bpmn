        <dc:Bounds x="510.0" y="520" width="220.0" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RevisionFinancialImpact_di" bpmnElement="Gateway_RevisionFinancialImpact" isMarkerVisible="true">
        <dc:Bounds x="760.0" y="555.0" width="50.0" height="50.0"/>
