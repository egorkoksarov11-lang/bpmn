<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CorporateEvents" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:process id="Process_CorporateEvents" name="Организация и проведение корпоративных мероприятий" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Auth" name="Уполномоченное лицо">
        <bpmn:flowNodeRef>Task_ApproveChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveAnnualPlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EventDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Unplanned</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Fin" name="Руководитель финансового блока">
        <bpmn:flowNodeRef>Task_FinanceConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BudgetCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BudgetCorrectionChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChangeFinanceConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinApproveReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_WithinBudget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ChangeWithinBudget</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="HR">
        <bpmn:flowNodeRef>Task_AnnualPlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareProposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviseProposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Organize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HoldEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Annual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RevisionFinancialImpact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Event</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ChangeFinancialImpact</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Annual" name="До 1 декабря">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_AnnualPlan" name="Сформировать план корпоративных мероприятий на следующий год">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_11mzvbn">
        <bpmn:targetRef>DR_AnnualPlan_Out</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_ApproveAnnualPlan" name="Утвердить план корпоративных мероприятий">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_Prepare" name="Не позднее чем за 1 месяц до мероприятия">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:timerEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:startEvent id="Start_Unplanned" name="Решение о проведении внепланового мероприятия">
      <bpmn:outgoing>FU1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_PrepareProposal" name="Подготовить предложение: параметры, стоимость; при превышении бюджета указать причины дополнительной потребности">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:incoming>FU1</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_FinanceConfirm" name="Подтвердить возможность финансирования в требуемой сумме и срок">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:incoming>FRY</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_WithinBudget" name="Требуется увеличение утвержденного HR-бюджета?">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F6N</bpmn:outgoing>
      <bpmn:outgoing>F6Y</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="Task_BudgetCorrection" name="Корректировка HR-бюджета">
      <bpmn:incoming>F6Y</bpmn:incoming>
      <bpmn:outgoing>F6C</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:task id="Task_ApproveEvent" name="Рассмотреть предложение и принять решение по мероприятию">
      <bpmn:incoming>F6N</bpmn:incoming>
      <bpmn:incoming>F6C</bpmn:incoming>
      <bpmn:incoming>FRN</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_EventDecision" name="Решение по мероприятию">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8B</bpmn:outgoing>
      <bpmn:outgoing>F8R</bpmn:outgoing>
      <bpmn:outgoing>F8X</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ReviseProposal" name="Скорректировать предложение по замечаниям Уполномоченного лица">
      <bpmn:incoming>F8R</bpmn:incoming>
      <bpmn:outgoing>FR1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_RevisionFinancialImpact" name="Изменилась сумма или срок финансирования?">
      <bpmn:incoming>FR1</bpmn:incoming>
      <bpmn:outgoing>FRN</bpmn:outgoing>
      <bpmn:outgoing>FRY</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Cancelled" name="Отказ от проведения мероприятия">
      <bpmn:incoming>F8X</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Organize" name="Организовать мероприятие: площадка, поставщики, заказы, информирование">
      <bpmn:incoming>F8B</bpmn:incoming>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Change" name="Требуется изменение согласованных параметров / дополнительная потребность?">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10N</bpmn:outgoing>
      <bpmn:outgoing>F10Y</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_PrepareChange" name="Подготовить измененные параметры; при дополнительной потребности указать причины">
      <bpmn:incoming>F10Y</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ChangeFinancialImpact" name="Изменение влияет на сумму или срок финансирования?">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12N</bpmn:outgoing>
      <bpmn:outgoing>F12Y</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ChangeFinanceConfirm" name="Подтвердить финансирование при изменении суммы / срока">
      <bpmn:incoming>F12Y</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ChangeWithinBudget" name="Требуется увеличение утвержденного HR-бюджета?">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F13N</bpmn:outgoing>
      <bpmn:outgoing>F13Y</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="Task_BudgetCorrectionChange" name="Корректировка HR-бюджета при изменении мероприятия">
      <bpmn:incoming>F13Y</bpmn:incoming>
      <bpmn:outgoing>F13C</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:task id="Task_ApproveChange" name="Согласовать изменение мероприятия">
      <bpmn:incoming>F12N</bpmn:incoming>
      <bpmn:incoming>F13N</bpmn:incoming>
      <bpmn:incoming>F13C</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_HoldEvent" name="Провести корпоративное мероприятие">
      <bpmn:incoming>F10N</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Report" name="Собрать подтверждающие документы и сформировать отчет о мероприятии и расходах">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SendReport" name="Передать отчет и комплект подтверждающих документов руководителю финансового блока">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Event" name="Мероприятие закрыто">
      <bpmn:incoming>F18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_FinApproveReport" name="Согласовать отчет о проведении корпоративного мероприятия и расходах">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:property id="Property_1qfjosi" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DataInputAssociation_1p6ejvy">
        <bpmn:sourceRef>DR_Report_FinIn</bpmn:sourceRef>
        <bpmn:targetRef>Property_1qfjosi</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Annual" targetRef="Task_AnnualPlan"/>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_AnnualPlan" targetRef="Task_ApproveAnnualPlan"/>
    <bpmn:sequenceFlow id="F3" sourceRef="Task_ApproveAnnualPlan" targetRef="Event_Prepare"/>
    <bpmn:sequenceFlow id="F4" sourceRef="Event_Prepare" targetRef="Task_PrepareProposal"/>
    <bpmn:sequenceFlow id="FU1" sourceRef="Start_Unplanned" targetRef="Task_PrepareProposal"/>
    <bpmn:sequenceFlow id="F5" sourceRef="Task_PrepareProposal" targetRef="Task_FinanceConfirm"/>
    <bpmn:sequenceFlow id="F6" sourceRef="Task_FinanceConfirm" targetRef="Gateway_WithinBudget"/>
    <bpmn:sequenceFlow id="F6N" name="Нет" sourceRef="Gateway_WithinBudget" targetRef="Task_ApproveEvent"/>
    <bpmn:sequenceFlow id="F6Y" name="Да" sourceRef="Gateway_WithinBudget" targetRef="Task_BudgetCorrection"/>
    <bpmn:sequenceFlow id="F6C" sourceRef="Task_BudgetCorrection" targetRef="Task_ApproveEvent"/>
    <bpmn:sequenceFlow id="F7" sourceRef="Task_ApproveEvent" targetRef="Gateway_EventDecision"/>
    <bpmn:sequenceFlow id="F8B" name="Согласовать с изменением параметров / Согласовать" sourceRef="Gateway_EventDecision" targetRef="Task_Organize"/>
    <bpmn:sequenceFlow id="F8R" name="Направить на доработку" sourceRef="Gateway_EventDecision" targetRef="Task_ReviseProposal"/>
    <bpmn:sequenceFlow id="F8X" name="Отказаться от проведения" sourceRef="Gateway_EventDecision" targetRef="End_Cancelled"/>
    <bpmn:sequenceFlow id="FR1" sourceRef="Task_ReviseProposal" targetRef="Gateway_RevisionFinancialImpact"/>
    <bpmn:sequenceFlow id="FRN" name="Нет" sourceRef="Gateway_RevisionFinancialImpact" targetRef="Task_ApproveEvent"/>
    <bpmn:sequenceFlow id="FRY" name="Да" sourceRef="Gateway_RevisionFinancialImpact" targetRef="Task_FinanceConfirm"/>
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Organize" targetRef="Gateway_Change"/>
    <bpmn:sequenceFlow id="F10N" name="Нет" sourceRef="Gateway_Change" targetRef="Task_HoldEvent"/>
    <bpmn:sequenceFlow id="F10Y" name="Да" sourceRef="Gateway_Change" targetRef="Task_PrepareChange"/>
    <bpmn:sequenceFlow id="F11" sourceRef="Task_PrepareChange" targetRef="Gateway_ChangeFinancialImpact"/>
    <bpmn:sequenceFlow id="F12N" name="Нет" sourceRef="Gateway_ChangeFinancialImpact" targetRef="Task_ApproveChange"/>
    <bpmn:sequenceFlow id="F12Y" name="Да" sourceRef="Gateway_ChangeFinancialImpact" targetRef="Task_ChangeFinanceConfirm"/>
    <bpmn:sequenceFlow id="F13" sourceRef="Task_ChangeFinanceConfirm" targetRef="Gateway_ChangeWithinBudget"/>
    <bpmn:sequenceFlow id="F13N" name="Нет" sourceRef="Gateway_ChangeWithinBudget" targetRef="Task_ApproveChange"/>
    <bpmn:sequenceFlow id="F13Y" name="Да" sourceRef="Gateway_ChangeWithinBudget" targetRef="Task_BudgetCorrectionChange"/>
    <bpmn:sequenceFlow id="F13C" sourceRef="Task_BudgetCorrectionChange" targetRef="Task_ApproveChange"/>
    <bpmn:sequenceFlow id="F14" sourceRef="Task_ApproveChange" targetRef="Task_Organize"/>
    <bpmn:sequenceFlow id="F15" sourceRef="Task_HoldEvent" targetRef="Task_Report"/>
    <bpmn:sequenceFlow id="F16" sourceRef="Task_Report" targetRef="Task_SendReport"/>
    <bpmn:sequenceFlow id="F17" sourceRef="Task_SendReport" targetRef="Task_FinApproveReport"/>
    <bpmn:sequenceFlow id="F18" sourceRef="Task_FinApproveReport" targetRef="End_Event"/>
    <bpmn:dataObject id="DO_AnnualPlan"/>
    <bpmn:dataObjectReference id="DR_AnnualPlan_Out" name="План корпоративных мероприятий" dataObjectRef="DO_AnnualPlan"/>
    <bpmn:dataObject id="DO_Proposal"/>
    <bpmn:dataObjectReference id="DR_Proposal_Out" name="Предложение по проведению корпоративного мероприятия" dataObjectRef="DO_Proposal"/>
    <bpmn:dataObjectReference id="DR_Proposal_FinIn" name="Предложение по проведению корпоративного мероприятия" dataObjectRef="DO_Proposal"/>
    <bpmn:dataObject id="DO_Report"/>
    <bpmn:dataObjectReference id="DR_Report_Out" name="Отчет о проведении корпоративного мероприятия и расходах" dataObjectRef="DO_Report"/>
    <bpmn:dataObjectReference id="DR_Proposal_OrganizeIn" name="Предложение по проведению корпоративного мероприятия" dataObjectRef="DO_Proposal"/>
    <bpmn:dataObjectReference id="DR_Report_FinIn" name="Отчет о проведении корпоративного мероприятия и расходах" dataObjectRef="DO_Report"/>
    <bpmn:association id="A_Prop_Out" associationDirection="One" sourceRef="Task_PrepareProposal" targetRef="DR_Proposal_Out"/>
    <bpmn:association id="A_Prop_FinIn" associationDirection="One" sourceRef="DR_Proposal_FinIn" targetRef="Task_FinanceConfirm"/>
    <bpmn:association id="A_Report_Out" associationDirection="One" sourceRef="Task_Report" targetRef="DR_Report_Out"/>
    <bpmn:association id="A_Prop_OrganizeIn" associationDirection="One" sourceRef="DR_Proposal_OrganizeIn" targetRef="Task_Organize"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_CorporateEvents">
      <bpmndi:BPMNShape id="Lane_HR_di" bpmnElement="Lane_HR" isHorizontal="true">
        <dc:Bounds x="30" y="65" width="1530.0" height="623"/>
      </bpmndi:BPMNShape>
