<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PersonalFiles" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Main" name="Организация" processRef="Process_PersonalFiles"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_PersonalFiles" name="Ведение и актуализация личных дел сотрудников" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Personnel" name="Кадровик">
        <bpmn:flowNodeRef>Start_Update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckNeed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Include</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Hire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Current</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CloseFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Archive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Archived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckCompleteness</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaitDocument</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Updated</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Update" name="Сформирован новый документ / изменились сведения сотрудника"/>
    <bpmn:task id="Task_CheckNeed" name="5.2 Проверить необходимость включения документа в личное дело"/>
    <bpmn:exclusiveGateway id="Gateway_Include" name="Документ входит в установленный состав?"/>
    <bpmn:task id="Task_UpdateFile" name="5.3 Актуализировать личное дело">
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0a19uzl">
        <bpmn:targetRef>DR_Inventory_Update</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_18b4cmc">
        <bpmn:targetRef>DR_File_Update</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObjectReference id="DR_Inventory" name="Внутренняя опись документов дела" dataObjectRef="DO_Inventory"/>
    <bpmn:dataObjectReference id="DR_File_Update" name="Личное дело сотрудника" dataObjectRef="DO_File"/>
    <bpmn:task id="Task_CreateFile" name="5.1 Сформировать личное дело">
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1h0ktpn">
        <bpmn:targetRef>DR_Composition_Check</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1kirtse">
        <bpmn:targetRef>DR_File</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_04l1gny">
        <bpmn:targetRef>DR_Inventory</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:startEvent id="Start_Hire" name="Завершен процесс «Прием сотрудника»"/>
    <bpmn:endEvent id="End_Current" name="Личное дело сформировано и передано на текущее ведение"/>
    <bpmn:dataObjectReference id="DR_Composition_Check" name="Состав личного дела сотрудника" dataObjectRef="DO_Composition"/>
    <bpmn:dataObjectReference id="DR_File" name="Личное дело сотрудника" dataObjectRef="DO_File"/>
    <bpmn:dataObjectReference id="DR_Inventory_Update" name="Внутренняя опись документов дела" dataObjectRef="DO_Inventory"/>
    <bpmn:sequenceFlow id="F3" sourceRef="Start_Update" targetRef="Task_CheckNeed"/>
    <bpmn:sequenceFlow id="F4" sourceRef="Task_CheckNeed" targetRef="Gateway_Include"/>
    <bpmn:sequenceFlow id="F5" name="Нет" sourceRef="Gateway_Include" targetRef="End_NoUpdate"/>
    <bpmn:sequenceFlow id="F6" name="Да" sourceRef="Gateway_Include" targetRef="Task_UpdateFile"/>
    <bpmn:sequenceFlow id="F11" sourceRef="Task_WaitDocument" targetRef="Task_UpdateFile"/>
    <bpmn:sequenceFlow id="F7" sourceRef="Task_UpdateFile" targetRef="Task_CheckCompleteness"/>
    <bpmn:sequenceFlow id="F8" sourceRef="Task_CheckCompleteness" targetRef="Gateway_Complete"/>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Hire" targetRef="Task_CreateFile"/>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_CreateFile" targetRef="End_Current"/>
    <bpmn:sequenceFlow id="F12" sourceRef="Start_Dismissal" targetRef="Task_CloseFile"/>
    <bpmn:endEvent id="End_NoUpdate" name="Учет и хранение по правилам соответствующего процесса"/>
    <bpmn:task id="Task_CloseFile" name="5.5 Закрыть личное дело">
      <bpmn:property id="Property_0vnqo2w" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DataInputAssociation_1baszxx">
        <bpmn:sourceRef>DR_Composition_Close</bpmn:sourceRef>
        <bpmn:targetRef>Property_0vnqo2w</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1n362rp">
        <bpmn:targetRef>DR_Inventory_Close</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1xx268g">
        <bpmn:targetRef>DR_Certifier</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObjectReference id="DR_Certifier" name="Лист-заверитель дела" dataObjectRef="DO_Certifier"/>
    <bpmn:dataObject id="DO_Certifier"/>
    <bpmn:dataObjectReference id="DR_Inventory_Close" name="Внутренняя опись документов дела" dataObjectRef="DO_Inventory"/>
    <bpmn:dataObject id="DO_Inventory"/>
    <bpmn:dataObjectReference id="DR_File_Close" name="Личное дело сотрудника" dataObjectRef="DO_File"/>
    <bpmn:dataObjectReference id="DR_Composition_Close" name="Состав личного дела сотрудника" dataObjectRef="DO_Composition"/>
    <bpmn:dataObject id="DO_Composition"/>
    <bpmn:task id="Task_Archive" name="5.6 Передать закрытое личное дело на хранение"/>
    <bpmn:dataObjectReference id="DR_File_Archive" name="Личное дело сотрудника" dataObjectRef="DO_File"/>
    <bpmn:dataObject id="DO_File"/>
    <bpmn:endEvent id="End_Archived" name="Личное дело передано на хранение"/>
    <bpmn:sequenceFlow id="F13" sourceRef="Task_CloseFile" targetRef="Task_Archive"/>
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Archive" targetRef="End_Archived"/>
    <bpmn:startEvent id="Start_Dismissal" name="Завершен процесс «Увольнение сотрудника»"/>
    <bpmn:task id="Task_CheckCompleteness" name="5.4 Проверить комплектность"/>
    <bpmn:exclusiveGateway id="Gateway_Complete" name="Комплект полный?"/>
    <bpmn:task id="Task_WaitDocument" name="Дождаться формирования отсутствующего итогового документа"/>
    <bpmn:endEvent id="End_Updated" name="Личное дело актуализировано"/>
    <bpmn:sequenceFlow id="F9" name="Да" sourceRef="Gateway_Complete" targetRef="End_Updated"/>
    <bpmn:sequenceFlow id="F10" name="Нет" sourceRef="Gateway_Complete" targetRef="Task_WaitDocument"/>
    <bpmn:association id="A_Composition_Check" associationDirection="One" sourceRef="DR_Composition_Check" targetRef="Task_CheckNeed"/>
    <bpmn:association id="A_File_Close" associationDirection="One" sourceRef="Task_CloseFile" targetRef="DR_File_Close"/>
    <bpmn:association id="A_File_Archive" associationDirection="One" sourceRef="DR_File_Archive" targetRef="Task_Archive"/>
  </bpmn:process>
