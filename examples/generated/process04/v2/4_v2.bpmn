      <bpmn:incoming>F63</bpmn:incoming><bpmn:outgoing>F23</bpmn:outgoing></bpmn:callActivity>
    <bpmn:callActivity id="C_Contract_Operation" name="Подготовка, согласование и заключение договора для конкретной операции" calledElement="Process_Contract"><bpmn:incoming>F87</bpmn:incoming><bpmn:outgoing>F89</bpmn:outgoing></bpmn:callActivity><bpmn:userTask id="T55" name="5.5 Получить параметры операции и определить организацию-плательщика">
      <bpmn:incoming>F2</bpmn:incoming><bpmn:incoming>F23</bpmn:incoming><bpmn:incoming>F62</bpmn:incoming><bpmn:outgoing>F24</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G55_OperationOrg" name="Организация по конкретной операции допущена и имеет применимое договорное основание?"><bpmn:incoming>F24</bpmn:incoming><bpmn:outgoing>F86</bpmn:outgoing><bpmn:outgoing>F87</bpmn:outgoing><bpmn:outgoing>F88</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="T56" name="5.6 Сформировать и проверить комплект по операции">
      <bpmn:incoming>F29</bpmn:incoming><bpmn:incoming>F86</bpmn:incoming><bpmn:incoming>F89</bpmn:incoming><bpmn:outgoing>F25</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T57_CM" name="5.7 Подготовить или актуализировать параметры операции для внутреннего согласования">
