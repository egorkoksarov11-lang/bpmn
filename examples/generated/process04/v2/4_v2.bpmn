    <bpmn:userTask id="T57_FH" name="5.7 Контроль проработки операции">
      <bpmn:incoming>F26</bpmn:incoming><bpmn:outgoing>F27</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G57_FH" name="Готово к согласованию?" gatewayDirection="Diverging">
      <bpmn:incoming>F27</bpmn:incoming><bpmn:outgoing>F28</bpmn:outgoing><bpmn:outgoing>F29</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T57_UL" name="5.7 Согласовать конкретную операцию">
      <bpmn:incoming>F28</bpmn:incoming><bpmn:outgoing>F30</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G57_UL" name="Операция согласована?" gatewayDirection="Diverging">
      <bpmn:incoming>F30</bpmn:incoming><bpmn:outgoing>F31</bpmn:outgoing><bpmn:outgoing>F32</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T58" name="5.8 Передать операцию факторинговой компании">
      <bpmn:incoming>F31</bpmn:incoming><bpmn:outgoing>F33</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T58_Factor" name="5.8 Проверить комплект и подтвердить доступный остаток">
      <bpmn:incoming>F33</bpmn:incoming><bpmn:outgoing>F34</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G58" name="Результат проверки доступного остатка фактором?" gatewayDirection="Diverging">
      <bpmn:incoming>F34</bpmn:incoming><bpmn:outgoing>F35</bpmn:outgoing><bpmn:outgoing>F36</bpmn:outgoing><bpmn:outgoing>F73</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T59_Factor" name="5.9 Сформировать документы конкретной операции">
      <bpmn:incoming>F35</bpmn:incoming><bpmn:outgoing>F37</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T59_CM" name="5.9 Организовать подписание, контролировать возврат подписанных экземпляров и передать факторинговой компании">
      <bpmn:incoming>F37</bpmn:incoming><bpmn:outgoing>F38</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T510_CM" name="5.10 Получить подтверждение готовности к оплате и сформировать план">
      <bpmn:incoming>F38</bpmn:incoming><bpmn:incoming>F80</bpmn:incoming><bpmn:outgoing>F39</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T510_FH" name="5.10 Проверить подтверждение фактора, отсутствие незакрытых отклонений и плановые денежные данные">
      <bpmn:incoming>F39</bpmn:incoming><bpmn:outgoing>F40</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G511_Payer" name="Кто выполняет платеж?" gatewayDirection="Diverging">
      <bpmn:incoming>F79</bpmn:incoming><bpmn:outgoing>F41</bpmn:outgoing><bpmn:outgoing>F42</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T511_Client" name="5.11 Выполнить платеж фактору">
      <bpmn:incoming>F74</bpmn:incoming><bpmn:outgoing>F43</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T511_Internal" name="5.11 Провести безналичный платеж по данным Реестра ДДС">
      <bpmn:incoming>F81</bpmn:incoming><bpmn:outgoing>F44</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G511_Merge" name="Платеж выполнен" gatewayDirection="Converging">
      <bpmn:incoming>F43</bpmn:incoming><bpmn:incoming>F44</bpmn:incoming><bpmn:outgoing>F45</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T512_CM" name="5.12 Получить подтверждение фактора и сверить сумму, назначение и реквизиты платежа">
      <bpmn:incoming>F47</bpmn:incoming><bpmn:outgoing>F82</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T512_Factor" name="5.12 Подтвердить получение платежа">
      <bpmn:incoming>F46</bpmn:incoming><bpmn:incoming>F50</bpmn:incoming><bpmn:incoming>F76</bpmn:incoming><bpmn:outgoing>F47</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G512" name="Подтверждены сумма, назначение и реквизиты платежа?" gatewayDirection="Diverging">
      <bpmn:incoming>F82</bpmn:incoming><bpmn:outgoing>F48</bpmn:outgoing><bpmn:outgoing>F49</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T512_FH" name="Урегулировать существенные отклонения">
      <bpmn:incoming>F75</bpmn:incoming><bpmn:outgoing>F50</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T513_CM" name="5.13 Сформировать обязательство по наличной выдаче и файл выгрузки">
      <bpmn:incoming>F48</bpmn:incoming><bpmn:outgoing>F51</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T513_FH" name="5.13 Проверить план выдачи и отразить в Реестре ДДС">
      <bpmn:incoming>F51</bpmn:incoming><bpmn:outgoing>F52</bpmn:outgoing></bpmn:userTask>
    <bpmn:callActivity id="C_CashPlan" name="Планирование и исполнение наличных выплат" calledElement="Process_CashPayout">
      <bpmn:incoming>F52</bpmn:incoming><bpmn:incoming>F57</bpmn:incoming><bpmn:outgoing>F53</bpmn:outgoing></bpmn:callActivity>
    <bpmn:userTask id="T514_CM" name="5.14 Получить факт выдачи из процесса наличных выплат, обновить накопительную сумму и остаток в Рабочем файле">
      <bpmn:incoming>F53</bpmn:incoming><bpmn:outgoing>F54</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T514_FH" name="Сверить накопительный факт с планом, актуализировать Реестр ДДС и проверить отклонения">
      <bpmn:incoming>F54</bpmn:incoming><bpmn:incoming>F85</bpmn:incoming><bpmn:outgoing>F55</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G514" name="Накопительная фактическая сумма выдачи достигла плановой?" gatewayDirection="Diverging">
      <bpmn:incoming>F56</bpmn:incoming><bpmn:outgoing>F57</bpmn:outgoing><bpmn:outgoing>F84</bpmn:outgoing></bpmn:exclusiveGateway>
