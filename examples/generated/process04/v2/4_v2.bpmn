    <bpmn:startEvent id="S" name="Запрос на факторинговую операцию">
      <bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="G_Connected" name="Организация, указанная в запросе, ранее допущена к работе с факторинговой компанией?" gatewayDirection="Diverging">
      <bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing><bpmn:outgoing>F3</bpmn:outgoing></bpmn:exclusiveGateway>
