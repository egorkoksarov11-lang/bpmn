      <bpmn:incoming>F84</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="E_Stop" name="Операция прекращена">
      <bpmn:incoming>F7</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="T51_FH" name="5.1 Проверить полноту проработки возможности работы организации">
