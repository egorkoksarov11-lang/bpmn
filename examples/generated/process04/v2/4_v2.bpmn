      <bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G53_Source" name="Документы организации структуры?" gatewayDirection="Diverging">
      <bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing><bpmn:outgoing>F11</bpmn:outgoing></bpmn:exclusiveGateway>
