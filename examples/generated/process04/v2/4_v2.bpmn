      <bpmn:incoming>F65</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T53_HR" name="Предоставить кадровые документы">
      <bpmn:incoming>F67</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T53_Client" name="Предоставить документы внешней организации">
      <bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G53_Merge" name="Сбор документов из выбранных источников завершен" gatewayDirection="Converging">
      <bpmn:incoming>F14</bpmn:incoming><bpmn:incoming>F72</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T54" name="5.4 Направить полный первоначальный комплект факторинговой компании">
      <bpmn:incoming>F78</bpmn:incoming><bpmn:outgoing>F16</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T54_Factor" name="5.4 Рассмотреть организацию">
      <bpmn:incoming>F16</bpmn:incoming><bpmn:incoming>F19</bpmn:incoming><bpmn:outgoing>F17</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G54_Extra" name="Есть дополнительный запрос документов?" gatewayDirection="Diverging">
      <bpmn:incoming>F17</bpmn:incoming><bpmn:outgoing>F18</bpmn:outgoing><bpmn:outgoing>F20</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T54_Extra" name="Получить и направить дополнительные документы факторинговой компании; актуализировать перечень">
      <bpmn:incoming>F18</bpmn:incoming><bpmn:outgoing>F19</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G54_OK" name="Организация одобрена фактором?" gatewayDirection="Diverging">
      <bpmn:incoming>F20</bpmn:incoming><bpmn:outgoing>F21</bpmn:outgoing><bpmn:outgoing>F22</bpmn:outgoing></bpmn:exclusiveGateway>
