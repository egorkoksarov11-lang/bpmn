<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Contract" targetNamespace="http://example.com/contract">
  <bpmn:process id="Process_Contract" name="Подготовка, согласование и заключение договора" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="L_Init" name="Инициатор договора">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T52</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T53</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T54_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ProfileOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T54_Rework</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_LawProfile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T55_Reapprove</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T56_Own</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T56_CP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T57_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_CP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ChangeProfile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Profile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T57_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ChangeType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T57_New</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Dispute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T59_Apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Stop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T510_Init</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T513_Init</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>G_AddRoute</bpmn:flowNodeRef><bpmn:flowNodeRef>T54_AddRoute</bpmn:flowNodeRef><bpmn:flowNodeRef>G_ChangeJoin</bpmn:flowNodeRef><bpmn:flowNodeRef>T59_Init</bpmn:flowNodeRef><bpmn:flowNodeRef>T59_Continue</bpmn:flowNodeRef><bpmn:flowNodeRef>G59_ProfileImpact</bpmn:flowNodeRef><bpmn:flowNodeRef>C_Profile_Final</bpmn:flowNodeRef><bpmn:flowNodeRef>G510_Profile</bpmn:flowNodeRef><bpmn:flowNodeRef>G510_Merge</bpmn:flowNodeRef><bpmn:flowNodeRef>T511_Init</bpmn:flowNodeRef><bpmn:flowNodeRef>G55_ReapproveOK</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_UL" name="Уполномоченное лицо">
        <bpmn:flowNodeRef>T53_UL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T59_UL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T511_UL</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Profile" name="Профильный согласующий">
        <bpmn:flowNodeRef>T54_Profile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T57_Profile</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>T510_Profile</bpmn:flowNodeRef><bpmn:flowNodeRef>T55_Profile_Reapprove</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_Law" name="Юрист">
        <bpmn:flowNodeRef>T55_Law</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T57_Law</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T510_Law</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_CP" name="Контрагент">
        <bpmn:flowNodeRef>T57_CP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T511_CP</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Sec" name="Секретарь / делопроизводитель">
        <bpmn:flowNodeRef>T511_Sec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T512_Sec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T513_Sec</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>G512_Received</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="В профильном процессе определена необходимость договорного оформления">
      <bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="T52" name="5.2 Подготовить проект договорного документа">
      <bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T53" name="5.3 Проверить проект и сформировать Лист согласования">
      <bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing><bpmn:incoming>F7</bpmn:incoming></bpmn:userTask>
    <bpmn:userTask id="T53_UL" name="Предварительно согласовать состав согласующих">
      <bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing><bpmn:incoming>F58</bpmn:incoming></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Route" name="Маршрут согласован?">
      <bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing><bpmn:outgoing>F7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T54_Send" name="5.4 Направить проект договора и единый Лист согласования участникам утвержденного маршрута">
      <bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing><bpmn:incoming>F12</bpmn:incoming></bpmn:userTask>
    <bpmn:userTask id="T54_Profile" name="Проверить договор по своему направлению и зафиксировать результат в едином Листе согласования">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false"><bpmn:loopDataInputRef>DOR_ApprovalSheet</bpmn:loopDataInputRef><bpmn:inputDataItem id="T54_Profile_Item" name="Участник утвержденного маршрута"/></bpmn:multiInstanceLoopCharacteristics><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_ProfileOK" name="Все согласующие утвержденного маршрута зафиксировали окончательный результат «Согласовано»?">
      <bpmn:outgoing>F10</bpmn:outgoing><bpmn:outgoing>F11</bpmn:outgoing><bpmn:incoming>F57</bpmn:incoming></bpmn:exclusiveGateway>
    <bpmn:userTask id="T54_Rework" name="Урегулировать замечания и отказы согласующих, актуализировать проект и повторно направить его участникам утвержденного маршрута">
      <bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T55_Law" name="5.5 Провести юридическую проверку внутренне согласованного проекта и зафиксировать результат">
      <bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_LawProfile" name="Правки юриста затрагивают профильные условия?">
      <bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing><bpmn:outgoing>F15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T55_Reapprove" name="Определить затронутых профильных согласующих, направить им измененную часть и зафиксировать состав повторной проверки в Листе согласования">
      <bpmn:incoming>F15</bpmn:incoming><bpmn:incoming>F68</bpmn:incoming><bpmn:outgoing>F16</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T55_Profile_Reapprove" name="Повторно проверить измененную часть только затронутым профильным согласующим"><bpmn:multiInstanceLoopCharacteristics isSequential="false"><bpmn:loopDataInputRef>DOR_ApprovalSheet</bpmn:loopDataInputRef><bpmn:inputDataItem id="T55_Profile_Reapprove_Item" name="Затронутый профильный согласующий"/></bpmn:multiInstanceLoopCharacteristics><bpmn:incoming>F16</bpmn:incoming><bpmn:outgoing>F66</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="G55_ReapproveOK" name="Все затронутые профильные согласующие подтвердили измененную часть?" gatewayDirection="Diverging"><bpmn:incoming>F66</bpmn:incoming><bpmn:outgoing>F67</bpmn:outgoing><bpmn:outgoing>F68</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="G_Form" name="Исходная форма договора?">
      <bpmn:incoming>F14</bpmn:incoming><bpmn:incoming>F67</bpmn:incoming><bpmn:outgoing>F17</bpmn:outgoing><bpmn:outgoing>F18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T56_Own" name="5.6 Сформировать согласованную редакцию по форме организации">
      <bpmn:incoming>F17</bpmn:incoming><bpmn:outgoing>F19</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T56_CP" name="5.6 Сформировать согласованную редакцию с комментариями к изменениям">
      <bpmn:incoming>F18</bpmn:incoming><bpmn:outgoing>F20</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Merge" name="Редакция для контрагента готова">
      <bpmn:incoming>F19</bpmn:incoming><bpmn:incoming>F20</bpmn:incoming><bpmn:outgoing>F21</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T57_Send" name="5.7 Направить редакцию контрагенту">
      <bpmn:incoming>F21</bpmn:incoming><bpmn:outgoing>F22</bpmn:outgoing><bpmn:incoming>F34</bpmn:incoming></bpmn:userTask>
    <bpmn:userTask id="T57_CP" name="Рассмотреть редакцию и направить ответ">
      <bpmn:incoming>F22</bpmn:incoming><bpmn:outgoing>F23</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_CP" name="Контрагент согласовал редакцию?">
      <bpmn:incoming>F23</bpmn:incoming><bpmn:outgoing>F24</bpmn:outgoing><bpmn:outgoing>F25</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_ChangeProfile" name="Изменение затрагивает ранее согласованные параметры профильной операции?">
      <bpmn:incoming>F25</bpmn:incoming><bpmn:outgoing>F26</bpmn:outgoing><bpmn:outgoing>F28</bpmn:outgoing><bpmn:incoming>F63</bpmn:incoming></bpmn:exclusiveGateway>
    <bpmn:callActivity id="C_Profile" name="5.8 Передать измененные параметры на повторное согласование в профильный процесс и получить его решение" calledElement="Profile_Process">
      <bpmn:incoming>F26</bpmn:incoming><bpmn:outgoing>F27</bpmn:outgoing></bpmn:callActivity>
    <bpmn:userTask id="T57_Check" name="Актуализировать проект по решению профильного процесса (если он вызывался), определить затронутые направления и зафиксировать в Листе согласования только участников повторной проверки">
      <bpmn:incoming>F27</bpmn:incoming><bpmn:incoming>F28</bpmn:incoming><bpmn:outgoing>F29</bpmn:outgoing></bpmn:userTask>
    <bpmn:inclusiveGateway id="G_ChangeType" name="Какие внутренние направления затронуты изменениями? (может быть выбрано несколько)" gatewayDirection="Diverging" default="F69">
      <bpmn:incoming>F29</bpmn:incoming><bpmn:outgoing>F30</bpmn:outgoing><bpmn:outgoing>F31</bpmn:outgoing><bpmn:outgoing>F69</bpmn:outgoing></bpmn:inclusiveGateway>
    <bpmn:userTask id="T57_Profile" name="Повторно согласовать измененную часть только с затронутыми профильными участниками (финансовое, учетное, техническое и проектное направления — при применимости)">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false"><bpmn:loopDataInputRef>DOR_ApprovalSheet</bpmn:loopDataInputRef><bpmn:inputDataItem id="T57_Profile_Item" name="Затронутый профильный согласующий"/></bpmn:multiInstanceLoopCharacteristics><bpmn:incoming>F30</bpmn:incoming><bpmn:outgoing>F32</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T57_Law" name="Повторно согласовать только затронутые юридические изменения">
      <bpmn:incoming>F31</bpmn:incoming><bpmn:outgoing>F33</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T57_New" name="Сформировать следующую единую редакцию после завершения необходимых внутренних проверок">
      <bpmn:incoming>F35</bpmn:incoming><bpmn:incoming>F69</bpmn:incoming><bpmn:outgoing>F34</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Dispute" name="Остались разногласия, неурегулированные в пределах полномочий участников?">
      <bpmn:outgoing>F35</bpmn:outgoing><bpmn:outgoing>F36</bpmn:outgoing><bpmn:incoming>F64</bpmn:incoming></bpmn:exclusiveGateway>
    <bpmn:userTask id="T59_UL" name="5.9 Принять решение по неурегулированным разногласиям">
      <bpmn:incoming>F37</bpmn:incoming><bpmn:outgoing>F65</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Dec" name="Решение уполномоченного лица">
      <bpmn:outgoing>F38</bpmn:outgoing><bpmn:outgoing>F39</bpmn:outgoing><bpmn:outgoing>F62</bpmn:outgoing><bpmn:incoming>F65</bpmn:incoming></bpmn:exclusiveGateway>
    <bpmn:userTask id="T59_Apply" name="Учесть принятое отклонение и актуализировать редакцию договора">
      <bpmn:incoming>F39</bpmn:incoming><bpmn:outgoing>F40</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="E_Stop" name="Договор не заключается">
      <bpmn:incoming>F38</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="T510_Init" name="5.10 Актуализировать итоговую редакцию по результату профильного процесса (если он вызывался), проверить изменения и определить затронутых профильных согласующих для повторного подтверждения">
      <bpmn:incoming>F24</bpmn:incoming><bpmn:outgoing>F41</bpmn:outgoing><bpmn:incoming>F60</bpmn:incoming><bpmn:incoming>F61</bpmn:incoming></bpmn:userTask>
    <bpmn:userTask id="T510_Law" name="5.10 Подтвердить отсутствие юридических замечаний">
      <bpmn:incoming>F41</bpmn:incoming><bpmn:outgoing>F42</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T511_Sec" name="5.11 Организовать подписание">
      <bpmn:incoming>F47</bpmn:incoming><bpmn:outgoing>F48</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T511_UL" name="Подписать со стороны организации">
      <bpmn:incoming>F48</bpmn:incoming><bpmn:outgoing>F49</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T511_CP" name="Подписать со стороны контрагента">
      <bpmn:incoming>F49</bpmn:incoming><bpmn:outgoing>F50</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T512_Sec" name="Организовать обмен подписанными экземплярами и контролировать получение экземпляра, подписанного обеими сторонами">
      <bpmn:incoming>F50</bpmn:incoming><bpmn:outgoing>F51</bpmn:outgoing><bpmn:incoming>F53</bpmn:incoming></bpmn:userTask>
    <bpmn:userTask id="T513_Sec" name="5.13 Передать подписанный документ инициатору и на хранение">
      <bpmn:incoming>F52</bpmn:incoming><bpmn:outgoing>F54</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T513_Init" name="5.13 Зафиксировать договорное основание в профильном процессе">
      <bpmn:incoming>F54</bpmn:incoming><bpmn:outgoing>F55</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="E" name="Договор заключен">
      <bpmn:incoming>F55</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_AddRoute" name="Требуется подключить дополнительное направление?" gatewayDirection="Diverging"><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F56</bpmn:outgoing><bpmn:outgoing>F57</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="T54_AddRoute" name="Дополнить Лист согласования новым направлением и передать изменение состава на предварительное утверждение"><bpmn:incoming>F56</bpmn:incoming><bpmn:outgoing>F58</bpmn:outgoing></bpmn:userTask><bpmn:inclusiveGateway id="G_ChangeJoin" name="Все затронутые направления завершили повторную проверку" gatewayDirection="Converging"><bpmn:incoming>F32</bpmn:incoming><bpmn:incoming>F33</bpmn:incoming><bpmn:outgoing>F64</bpmn:outgoing></bpmn:inclusiveGateway><bpmn:userTask id="T59_Init" name="5.9 Сформировать и передать уполномоченному лицу спорные положения, внутреннюю позицию и позицию контрагента"><bpmn:incoming>F36</bpmn:incoming><bpmn:outgoing>F37</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="T59_Continue" name="Подготовить редакцию для продолжения переговоров на иных условиях"><bpmn:incoming>F62</bpmn:incoming><bpmn:outgoing>F63</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="G59_ProfileImpact" name="Принятое отклонение затрагивает ранее согласованные параметры профильной операции?" gatewayDirection="Diverging"><bpmn:incoming>F40</bpmn:incoming><bpmn:outgoing>F59</bpmn:outgoing><bpmn:outgoing>F60</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:callActivity id="C_Profile_Final" name="Повторно согласовать принятые изменения параметров в профильном процессе и получить решение" calledElement="Profile_Process"><bpmn:incoming>F59</bpmn:incoming><bpmn:outgoing>F61</bpmn:outgoing></bpmn:callActivity><bpmn:exclusiveGateway id="G510_Profile" name="Профильные условия изменялись после последнего согласования?" gatewayDirection="Diverging"><bpmn:incoming>F42</bpmn:incoming><bpmn:outgoing>F43</bpmn:outgoing><bpmn:outgoing>F44</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="T510