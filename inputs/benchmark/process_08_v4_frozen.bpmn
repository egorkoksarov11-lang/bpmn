  <bpmn:userTask id="T51d" name="Запросить уточнение параметров поручения"><bpmn:documentation>Клиентский менеджер направляет запрос уполномоченному лицу в рамках того же поручения.</bpmn:documentation><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F72</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="T54c" name="Уточнить вариант по замечаниям"><bpmn:documentation>Клиентский менеджер уточняет вариант по замечаниям руководителя финансового блока и повторно передает его на контроль.</bpmn:documentation><bpmn:incoming>F16</bpmn:incoming><bpmn:outgoing>F73</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="G58d" name="На каком этапе выявлено изменение?"><bpmn:documentation>Выход определяется фактическим состоянием операции: до оплаты — повторная проверка готовности к оплате; после оплаты — продолжение контроля исполнения поставщиком.</bpmn:documentation><bpmn:incoming>F66</bpmn:incoming><bpmn:outgoing>F76</bpmn:outgoing><bpmn:outgoing>F77</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="G511a" name="Платеж исполнен?"><bpmn:incoming>F41</bpmn:incoming><bpmn:outgoing>F78</bpmn:outgoing><bpmn:outgoing>F79</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="G511b" name="Какое действие требуется?"><bpmn:documentation>Проектное решение по обработке результата платежа: при неисполненном платеже допускается повторное проведение после корректировки задачи либо выбор другого варианта; при изменении существенных условий применяется пункт 5.8; если отклонение урегулировано, процесс продолжается контролем исполнения поставщика.</bpmn:documentation><bpmn:incoming>F45</bpmn:incoming><bpmn:outgoing>F81</bpmn:outgoing><bpmn:outgoing>F82</bpmn:outgoing><bpmn:outgoing>F83</bpmn:outgoing><bpmn:outgoing>F84</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="T511d" name="Скорректировать задачу на платеж"><bpmn:documentation>После решения руководителя финансового блока клиентский менеджер корректирует платежную задачу и передает ее на повторное проведение.</bpmn:documentation><bpmn:incoming>F81</bpmn:incoming><bpmn:outgoing>F85</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="G512" name="Изменились срок или иные условия исполнения?"><bpmn:incoming>F46</bpmn:incoming><bpmn:outgoing>F87</bpmn:outgoing><bpmn:outgoing>F88</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="T516c" name="Определить причину незакрытия и организовать устранение"><bpmn:documentation>При нескольких незакрытых вопросах определяется наиболее ранний затронутый этап. После возврата к нему процесс повторно проходит последующие контрольные операции.</bpmn:documentation><bpmn:incoming>F62</bpmn:incoming><bpmn:outgoing>F92</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="G516a" name="На каком этапе требуется доработка?"><bpmn:documentation>Если одновременно выявлено несколько незакрытых вопросов, выбирается наиболее ранний затронутый этап. После возврата процесс последовательно повторяет последующие проверки и вновь проходит итоговый контроль.</bpmn:documentation><bpmn:incoming>F92</bpmn:incoming><bpmn:outgoing>F93</bpmn:outgoing><bpmn:outgoing>F94</bpmn:outgoing><bpmn:outgoing>F95</bpmn:outgoing><bpmn:outgoing>F96</bpmn:outgoing><bpmn:outgoing>F97</bpmn:outgoing><bpmn:outgoing>F98</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:sequenceFlow id="F72" sourceRef="T51d" targetRef="T51c"/><bpmn:sequenceFlow id="F73" sourceRef="T54c" targetRef="T54a"/><bpmn:sequenceFlow id="F74" sourceRef="G57" targetRef="T59a" name="Есть допустимые отклонения"/><bpmn:sequenceFlow id="F75" sourceRef="G57" targetRef="T52" name="Не соответствует"/><bpmn:sequenceFlow id="F76" sourceRef="G58d" targetRef="T59a" name="До оплаты"/><bpmn:sequenceFlow id="F77" sourceRef="G58d" targetRef="T512a" name="После оплаты"/><bpmn:sequenceFlow id="F78" sourceRef="G511a" targetRef="T511b" name="Да"/><bpmn:sequenceFlow id="F79" sourceRef="G511a" targetRef="T511c" name="Нет"/><bpmn:sequenceFlow id="F81" sourceRef="G511b" targetRef="T511d" name="Повторить платеж"/><bpmn:sequenceFlow id="F82" sourceRef="G511b" targetRef="T58a" name="Изменить существенные условия"/><bpmn:sequenceFlow id="F83" sourceRef="G511b" targetRef="T512a" name="Отклонение урегулировано"/><bpmn:sequenceFlow id="F84" sourceRef="G511b" targetRef="T52" name="Новый вариант (платеж не исполнен)"/><bpmn:sequenceFlow id="F85" sourceRef="T511d" targetRef="T511a"/><bpmn:sequenceFlow id="F87" sourceRef="G512" targetRef="T512b" name="Нет"/><bpmn:sequenceFlow id="F88" sourceRef="G512" targetRef="T58a" name="Да"/><bpmn:sequenceFlow id="F89" sourceRef="G514" targetRef="T515" name="Есть допустимые отклонения"/><bpmn:sequenceFlow id="F90" sourceRef="G514" targetRef="T514c" name="Не соответствует"/><bpmn:sequenceFlow id="F92" sourceRef="T516c" targetRef="G516a"/><bpmn:sequenceFlow id="F93" sourceRef="G516a" targetRef="T512a" name="Исполнение поставщика"/><bpmn:sequenceFlow id="F94" sourceRef="G516a" targetRef="T513" name="Комплект документов"/><bpmn:sequenceFlow id="F95" sourceRef="G516a" targetRef="T514" name="Техническое подтверждение"/><bpmn:sequenceFlow id="F96" sourceRef="G516a" targetRef="T515" name="Проверка бухгалтера"/><bpmn:sequenceFlow id="F97" sourceRef="G516a" targetRef="T58a" name="Существенные условия"/><bpmn:sequenceFlow id="F98" sourceRef="G516a" targetRef="T516a" name="Итоговые данные"/><bpmn:dataObject id="DO_Order" name="Поручение"/><bpmn:dataObject id="DO_LegalCheckResult" name="Результат проверки ЮЛ"/><bpmn:dataObject id="DO_ContractBasis" name="Договорное основание"/><bpmn:dataObject id="DO_PrePaymentDocs" name="Документы до оплаты"/><bpmn:dataObject id="DO_InitialTechData" name="Исходные тех. данные"/><bpmn:dataObject id="DO_TechCheckTask" name="Задача техпроверки"/><bpmn:dataObject id="DO_PaymentTask" name="Задача на платеж"/><bpmn:dataObject id="DO_BankDocument" name="Банковский документ"/><bpmn:dataObject id="DO_ClosingDocs" name="Закрывающие документы"/><bpmn:dataObject id="DO_AccountantTask" name="Задача бухгалтеру"/><bpmn:dataObjectReference id="DOR_Order" name="Поручение" dataObjectRef="DO_Order"/><bpmn:dataStoreReference id="DSR_SupplierOptions" name="Перечень поставщиков" dataStoreRef="DS_SupplierOptions"/><bpmn:dataObjectReference id="DOR_LegalCheck" name="Результат проверки ЮЛ" dataObjectRef="DO_LegalCheckResult"/><bpmn:dataObjectReference id="DOR_ContractBasis_Existing" name="Договор / основание" dataObjectRef="DO_ContractBasis"/><bpmn:dataObjectReference id="DOR_ContractBasis_Final" name="Договор / основание" dataObjectRef="DO_ContractBasis"/><bpmn:dataObjectReference id="DOR_PrePaymentDocs" name="Документы до оплаты" dataObjectRef="DO_PrePaymentDocs"/><bpmn:dataObjectReference id="DOR_InitialTechData" name="Тех. данные" dataObjectRef="DO_InitialTechData"/><bpmn:dataObjectReference id="DOR_TechTask" name="Задача техпроверки" dataObjectRef="DO_TechCheckTask"/><bpmn:dataObjectReference id="DOR_PaymentTask" name="Задача на платеж" dataObjectRef="DO_PaymentTask"/><bpmn:dataObjectReference id="DOR_BankDocument" name="Банк. документ" dataObjectRef="DO_BankDocument"/><bpmn:dataObjectReference id="DOR_ClosingDocs" name="Закрывающие документы" dataObjectRef="DO_ClosingDocs"/><bpmn:dataObjectReference id="DOR_AccountantTask" name="Задача бух." dataObjectRef="DO_AccountantTask"/><bpmn:dataStoreReference id="DSR_OperationsFile_Plan" name="Рабочий файл: план" dataStoreRef="DS_OperationsFile"/><bpmn:dataStoreReference id="DSR_OperationsFile_Actual" name="Рабочий файл: факт" dataStoreRef="DS_OperationsFile"/><bpmn:dataStoreReference id="DSR_OperationsFile_Close" name="Рабочий файл: итог" dataStoreRef="DS_OperationsFile"/><bpmn:dataStoreReference id="DSR_CashFlow_Plan" name="Реестр ДДС: план" dataStoreRef="DS_CashFlowRegister"/><bpmn:dataStoreReference id="DSR_CashFlow_Fact" name="Реестр ДДС: факт" dataStoreRef="DS_CashFlowRegister"/><bpmn:association id="A_Order_Out" sourceRef="T51a" targetRef="DOR_Order" associationDirection="One"/><bpmn:association id="A_SupplierOptions_Update" sourceRef="T52" targetRef="DSR_Su