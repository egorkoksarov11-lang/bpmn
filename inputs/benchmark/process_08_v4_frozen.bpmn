<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://example.com/bpmn">
  <bpmn:process id="Process_1" name="Организация операции через поставщика" isExecutable="false">
    <bpmn:documentation>Версия v4. Документная и информационная полнота добавлена по разделу 4 и пунктам 5.1–5.16 описания процесса и по приложенным формам. Бизнес-маршруты, типы бизнес-элементов, исполнители и sequenceFlow версии v3 сохранены без изменений. Добавлены только логические документы, рабочие хранилища, references и информационные associations.</bpmn:documentation><bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="L1" name="Уполномоченное лицо">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T51a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T51c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T54b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G54b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T58c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G58</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2" name="Руководитель финансового блока">
        <bpmn:flowNodeRef>T54a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G54a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T58b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T59b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G59</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T510b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T511c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T512b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T516b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G516</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>G511b</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L3" name="Клиентский менеджер">
        <bpmn:flowNodeRef>T51b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G51</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T52</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T53</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G53</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C53</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G53b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T55</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G55</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C55</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T56</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G56</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T58a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T59a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T510a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T511b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G511</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T512a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T513</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G513</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T514c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T515c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T516a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T510c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T57a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G57a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T58d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T59c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G513a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T513a</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>T51d</bpmn:flowNodeRef><bpmn:flowNodeRef>T54c</bpmn:flowNodeRef><bpmn:flowNodeRef>G58d</bpmn:flowNodeRef><bpmn:flowNodeRef>T511d</bpmn:flowNodeRef><bpmn:flowNodeRef>G512</bpmn:flowNodeRef><bpmn:flowNodeRef>T516c</bpmn:flowNodeRef><bpmn:flowNodeRef>G516a</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L4" name="Инженер ПТО">
        <bpmn:flowNodeRef>T57</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G57</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T514</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G514</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L5" name="Операционист">
        <bpmn:flowNodeRef>T511a</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>G511a</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L6" name="Главный бухгалтер">
        <bpmn:flowNodeRef>T515</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G515</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Возникла потребность провести операцию через поставщика">
      <bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="T51a" name="5.1 Оформить поручение">
      <bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T51b" name="5.1 Проверить достаточность параметров">
      <bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing><bpmn:incoming>F6</bpmn:incoming></bpmn:userTask>
    <bpmn:exclusiveGateway id="G51" name="Параметров достаточно?">
      <bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing><bpmn:outgoing>F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T51c" name="Предоставить уточненные параметры поручения">
      <bpmn:outgoing>F6</bpmn:outgoing><bpmn:incoming>F72</bpmn:incoming></bpmn:userTask>
    <bpmn:userTask id="T52" name="5.2 Подобрать и проработать варианты поставщиков">
      <bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing><bpmn:incoming>F13</bpmn:incoming><bpmn:incoming>F19</bpmn:incoming><bpmn:incoming>F34</bpmn:incoming><bpmn:incoming>F75</bpmn:incoming><bpmn:incoming>F84</bpmn:incoming></bpmn:userTask>
    <bpmn:userTask id="T53" name="5.3 Проверить участников выбранного варианта">
      <bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G53" name="По всем участникам есть действующие результаты проверок?">
      <bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing><bpmn:outgoing>F10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:callActivity id="C53" name="Проверка юридического лица" calledElement="Process_CheckLegal">
      <bpmn:documentation>Проверяются все участники выбранного варианта. Для каждого юридического лица, по которому результат отсутствует или утратил актуальность, выполняется процесс проверки; при изменении состава проверяется вновь включенное юридическое лицо.</bpmn:documentation><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:callActivity>
    <bpmn:exclusiveGateway id="G53b" name="Взаимодействие допустимо?">
      <bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing><bpmn:outgoing>F13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T54a" name="5.4 Проверить полноту проработки варианта">
      <bpmn:incoming>F9</bpmn:incoming><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing><bpmn:incoming>F73</bpmn:incoming></bpmn:userTask>
    <bpmn:exclusiveGateway id="G54a" name="Вариант проработан полностью?">
      <bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing><bpmn:outgoing>F16</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T54b" name="5.4 Согласовать выбранный вариант">
      <bpmn:incoming>F15</bpmn:incoming><bpmn:outgoing>F17</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G54b" name="Вариант согласован?">
      <bpmn:incoming>F17</bpmn:incoming><bpmn:outgoing>F18</bpmn:outgoing><bpmn:outgoing>F19</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T55" name="5.5 Определить применимое договорное основание">
      <bpmn:incoming>F18</bpmn:incoming><bpmn:outgoing>F20</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G55" name="Основание применимо?">
      <bpmn:incoming>F20</bpmn:incoming><bpmn:outgoing>F21</bpmn:outgoing><bpmn:outgoing>F22</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:callActivity id="C55" name="Подготовка, согласование и заключение договора" calledElement="Process_Contract">
      <bpmn:incoming>F22</bpmn:incoming><bpmn:outgoing>F23</bpmn:outgoing></bpmn:callActivity>
    <bpmn:userTask id="T56" name="5.6 Сформировать документы конкретной операции">
      <bpmn:incoming>F21</bpmn:incoming><bpmn:incoming>F23</bpmn:incoming><bpmn:outgoing>F24</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G56" name="Требуется техническая проверка?">
      <bpmn:incoming>F24</bpmn:incoming><bpmn:outgoing>F25</bpmn:outgoing><bpmn:outgoing>F26</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T57" name="5.7 Провести техническую проверку до оплаты">
      <bpmn:incoming>F25</bpmn:incoming><bpmn:outgoing>F27</bpmn:outgoing><bpmn:incoming>F65</bpmn:incoming></bpmn:userTask>
    <bpmn:exclusiveGateway id="G57" name="Результат технической проверки?">
      <bpmn:documentation>Проектное решение: результат «Не соответствует» означает отказ от выбранного варианта и возврат к подбору поставщика. Результат «Требуется корректировка» возвращается на получение исправленных документов и повторную техническую проверку. «Соответствует» и «Есть допустимые отклонения» позволяют перейти к проверке готовности к оплате.</bpmn:documentation><bpmn:incoming>F27</bpmn:incoming><bpmn:outgoing>F28</bpmn:outgoing><bpmn:outgoing>F29</bpmn:outgoing><bpmn:outgoing>F74</bpmn:outgoing><bpmn:outgoing>F75</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T58a" name="5.8 Актуализировать измененные условия">
      <bpmn:outgoing>F30</bpmn:outgoing><bpmn:incoming>F64</bpmn:incoming><bpmn:incoming>F82</bpmn:incoming><bpmn:incoming>F88</bpmn:incoming><bpmn:incoming>F97</bpmn:incoming></bpmn:userTask>
    <bpmn:userTask id="T58b" name="5.8 Проверить измененные условия">
      <bpmn:incoming>F30</bpmn:incoming><bpmn:outgoing>F31</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T58c" name="5.8 Согласовать измененные условия">
      <bpmn:incoming>F31</bpmn:incoming><bpmn:outgoing>F32</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G58" name="Изменения согласованы?">
      <bpmn:incoming>F32</bpmn:incoming><bpmn:outgoing>F33</bpmn:outgoing><bpmn:outgoing>F34</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T59a" name="5.9 Проверить готовность к оплате">
      <bpmn:incoming>F26</bpmn:incoming><bpmn:incoming>F28</bpmn:incoming><bpmn:outgoing>F35</bpmn:outgoing><bpmn:incoming>F67</bpmn:incoming><bpmn:incoming>F74</bpmn:incoming><bpmn:incoming>F76</bpmn:incoming></bpmn:userTask>
    <bpmn:userTask id="T59b" name="5.9 Контролировать готовность к оплате">
      <bpmn:incoming>F35</bpmn:incoming><bpmn:outgoing>F36</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G59" name="Операция готова к оплате?">
      <bpmn:incoming>F36</bpmn:incoming><bpmn:outgoing>F37</bpmn:outgoing><bpmn:outgoing>F38</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T510a" name="5.10 Сформировать плановые данные операции">
      <bpmn:incoming>F37</bpmn:incoming><bpmn:outgoing>F39</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T510b" name="5.10 Проверить плановые денежные данные">
      <bpmn:incoming>F39</bpmn:incoming><bpmn:outgoing>F40</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T511a" name="5.11 Провести платеж">
      <bpmn:outgoing>F41</bpmn:outgoing><bpmn:incoming>F71</bpmn:incoming><bpmn:incoming>F85</bpmn:incoming></bpmn:userTask>
    <bpmn:userTask id="T511b" name="5.11 Сверить фактический платеж с планом">
      <bpmn:outgoing>F42</bpmn:outgoing><bpmn:incoming>F78</bpmn:incoming></bpmn:userTask>
    <bpmn:exclusiveGateway id="G511" name="Есть отклонения в фактических данных платежа?">
      <bpmn:incoming>F42</bpmn:incoming><bpmn:outgoing>F43</bpmn:outgoing><bpmn:outgoing>F44</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T511c" name="5.11 Рассмотреть отклонение">
      <bpmn:incoming>F44</bpmn:incoming><bpmn:outgoing>F45</bpmn:outgoing><bpmn:incoming>F79</bpmn:incoming></bpmn:userTask>
    <bpmn:userTask id="T512a" name="5.12 Контролировать исполнение поставщиком">
      <bpmn:incoming>F43</bpmn:incoming><bpmn:outgoing>F46</bpmn:outgoing><bpmn:incoming>F77</bpmn:incoming><bpmn:incoming>F83</bpmn:incoming><bpmn:incoming>F93</bpmn:incoming></bpmn:userTask>
    <bpmn:userTask id="T512b" name="5.12 Контролировать незавершенные операции">
      <bpmn:outgoing>F47</bpmn:outgoing><bpmn:incoming>F87</bpmn:incoming></bpmn:userTask>
    <bpmn:userTask id="T513" name="5.13 Получить и проверить комплект документов по исполнению">
      <bpmn:incoming>F47</bpmn:incoming><bpmn:outgoing>F48</bpmn:outgoing><bpmn:incoming>F70</bpmn:incoming><bpmn:incoming>F94</bpmn:incoming></bpmn:userTask>
    <bpmn:exclusiveGateway id="G513" name="Нужно техническое подтверждение?">
      <bpmn:outgoing>F49</bpmn:outgoing><bpmn:outgoing>F50</bpmn:outgoing><bpmn:incoming>F68</bpmn:incoming></bpmn:exclusiveGateway>
    <bpmn:userTask id="T514" name="5.14 Подтвердить фактическое техническое исполнение">
      <bpmn:incoming>F50</bpmn:incoming><bpmn:outgoing>F51</bpmn:outgoing><bpmn:incoming>F54</bpmn:incoming><bpmn:incoming>F95</bpmn:incoming></bpmn:userTask>
    <bpmn:exclusiveGateway id="G514" name="Результат технической проверки?">
      <bpmn:documentation>Результаты «Соответствует» и «Есть допустимые отклонения» позволяют передать комплект главному бухгалтеру. При «Требуется корректировка» и «Не соответствует» клиентский менеджер организует урегулирование расхождений и повторное техническое подтверждение; до этого комплект не передается главному бухгалтеру.</bpmn:documentation><bpmn:incoming>F51</bpmn:incoming><bpmn:outgoing>F52</bpmn:outgoing><bpmn:outgoing>F53</bpmn:outgoing><bpmn:outgoing>F89</bpmn:outgoing><bpmn:outgoing>F90</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T514c" name="Урегулировать расхождения">
      <bpmn:incoming>F53</bpmn:incoming><bpmn:outgoing>F54</bpmn:outgoing><bpmn:incoming>F90</bpmn:incoming></bpmn:userTask>
    <bpmn:userTask id="T515" name="5.15 Проверить документы по исполнению">
      <bpmn:incoming>F49</bpmn:incoming><bpmn:incoming>F52</bpmn:incoming><bpmn:outgoing>F55</bpmn:outgoing><bpmn:incoming>F58</bpmn:incoming><bpmn:incoming>F89</bpmn:incoming><bpmn:incoming>F96</bpmn:incoming></bpmn:userTask>
    <bpmn:exclusiveGateway id="G515" name="Документы приняты?">
      <bpmn:incoming>F55</bpmn:incoming><bpmn:outgoing>F56</bpmn:outgoing><bpmn:outgoing>F57</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T515c" name="Получить исправленные / недостающие документы">
      <bpmn:incoming>F57</bpmn:incoming><bpmn:outgoing>F58</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T516a" name="5.16 Актуализировать итоговый статус">
      <bpmn:incoming>F56</bpmn:incoming><bpmn:outgoing>F59</bpmn:outgoing><bpmn:incoming>F98</bpmn:incoming></bpmn:userTask>
    <bpmn:userTask id="T516b" name="5.16 Контролировать закрытие операции">
      <bpmn:incoming>F59</bpmn:incoming><bpmn:outgoing>F60</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G516" name="Все вопросы закрыты?">
      <bpmn:incoming>F60</bpmn:incoming><bpmn:outgoing>F61</bpmn:outgoing><bpmn:outgoing>F62</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="E" name="Операция завершена">
      <bpmn:incoming>F61</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="T510c" name="5.10 Сформировать задачу на проведение платежа">
      <bpmn:documentation>Клиентский менеджер формирует задачу на проведение платежа после проверки плановых денежных данных руководителем финансового блока и передает ее операционисту вместе с платежным основанием.</bpmn:documentation>
      <bpmn:incoming>F40</bpmn:incoming><bpmn:outgoing>F71</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T57a" name="5.7 Получить уточненные / исправленные документы">
      <bpmn:documentation>Клиентский менеджер получает от поставщика уточненные или исправленные документы по результатам технической проверки.</bpmn:documentation>
      <bpmn:incoming>F29</bpmn:incoming><bpmn:outgoing>F63</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G57a" name="Изменены существенные условия?">
      <bpmn:incoming>F63</bpmn:incoming><bpmn:outgoing>F64</bpmn:outgoing><bpmn:outgoing>F65</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T58d" name="Организовать повторное выполнение затронутых проверок">
      <bpmn:documentation>Повторяются только те проверки, на которые повлияло изменение существенных условий: проверка участников, применимости договорного основания и/или техническая проверка. После повторных проверок маршрут определяется этапом, на котором выявлено изменение.</bpmn:documentation>
      <bpmn:incoming>F33</bpmn:incoming><bpmn:outgoing>F66</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T59c" name="Устранить замечания и повторно проверить готовность к оплате">
      <bpmn:documentation>После устранения замечаний повторно проверяется готовность к оплате. Переход к формированию плановых данных допускается только при отсутствии незакрытых вопросов.</bpmn:documentation>
      <bpmn:incoming>F38</bpmn:incoming><bpmn:outgoing>F67</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G513a" name="Комплект документов полный и соответствует операции?">
      <bpmn:incoming>F48</bpmn:incoming><bpmn:outgoing>F68</bpmn:outgoing><bpmn:outgoing>F69</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T513a" name="5.13 Вернуть документы поставщику на дополнение / исправление">
      <bpmn:documentation>При неполном комплекте клиентский менеджер возвращает документы поставщику на дополнение или исправление, после чего повторно проверяет комплектность.</bpmn:documentation>
      <bpmn:incoming>F69</bpmn:incoming><bpmn:outgoing>F70</bpmn:outgoing></bpmn:userTask>
