      <bpmndi:BPMNEdge id="Flow_Works_Yes_di" bpmnElement="Flow_Works_Yes">
        <di:waypoint x="1620" y="332" />
        <di:waypoint x="1700" y="332" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1637" y="310" width="14" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SendChecklist_ManagerReview_di" bpmnElement="Flow_SendChecklist_ManagerReview">
        <di:waypoint x="1780" y="300" />
        <di:waypoint x="1780" y="169" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManagerReview_Credentials_di" bpmnElement="Flow_ManagerReview_Credentials">
        <di:waypoint x="1860" y="137" />
        <di:waypoint x="1980" y="137" />
        <di:waypoint x="1980" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Credentials_FirstLogin_di" bpmnElement="Flow_Credentials_FirstLogin">
        <di:waypoint x="1980" y="364" />
        <di:waypoint x="1980" y="855" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1933" y="516" width="94" height="27" />
