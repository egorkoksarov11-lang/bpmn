<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process03" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:process id="Process_03" name="Подготовка к выходу нового сотрудника" isExecutable="false">
    <bpmn:laneSet id="LaneSet_03">
      <bpmn:lane id="Lane_NewEmployee" name="Новый сотрудник">
        <bpmn:flowNodeRef>Task_FirstLogin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Ready</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Procurement" name="Ответственный за приобретение оборудования">
        <bpmn:flowNodeRef>Call_Purchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandoverEquipment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT" name="ИТ-специалист">
        <bpmn:flowNodeRef>Task_CheckEquipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PurchaseRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Configure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Accounts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TechCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendChecklist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Credentials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Equipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Works</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Непосредственный руководитель">
        <bpmn:flowNodeRef>Task_Checklist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManagerReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_10Days</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Late</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:dataObject id="Data_Checklist" name="Чек-лист подготовки к выходу нового сотрудника" />
    <bpmn:dataObjectReference id="DataRef_Checklist_Start" name="Чек-лист подготовки к выходу нового сотрудника" dataObjectRef="Data_Checklist" />
    <bpmn:dataObjectReference id="DataRef_Checklist_Final" name="Чек-лист подготовки к выходу нового сотрудника" dataObjectRef="Data_Checklist" />
    <bpmn:dataObject id="Data_PurchaseRequest" name="Заявка на приобретение оборудования" />
    <bpmn:dataObjectReference id="DataRef_PurchaseRequest" name="Заявка на приобретение оборудования" dataObjectRef="Data_PurchaseRequest" />
    <bpmn:startEvent id="Start_10Days" name="За 10 дней до даты выхода">
      <bpmn:outgoing>Flow_Start_Checklist</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Checklist" name="Сформировать чек-лист подготовки к выходу">
      <bpmn:incoming>Flow_Start_Checklist</bpmn:incoming>
      <bpmn:incoming>Flow_Late_Checklist</bpmn:incoming>
      <bpmn:outgoing>Flow_Checklist_CheckEquipment</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CheckEquipment" name="Проверить наличие оборудования">
      <bpmn:incoming>Flow_Checklist_CheckEquipment</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckEquipment_Gateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Equipment" name="Оборудование имеется?">
      <bpmn:incoming>Flow_CheckEquipment_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Equipment_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Equipment_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PurchaseRequest" name="Сформировать заявку на приобретение оборудования">
      <bpmn:incoming>Flow_Equipment_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Request_Purchase</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:callActivity id="Call_Purchase" name="Приобрести оборудование">
      <bpmn:incoming>Flow_Request_Purchase</bpmn:incoming>
      <bpmn:outgoing>Flow_Purchase_Handover</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="Task_HandoverEquipment" name="Передать оборудование ИТ-специалисту">
      <bpmn:incoming>Flow_Purchase_Handover</bpmn:incoming>
      <bpmn:outgoing>Flow_Handover_Configure</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Configure" name="Настроить оборудование и ПО">
      <bpmn:incoming>Flow_Equipment_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_Handover_Configure</bpmn:incoming>
      <bpmn:outgoing>Flow_Configure_Accounts</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Accounts" name="Создать учетные записи, почту и доступы">
      <bpmn:incoming>Flow_Configure_Accounts</bpmn:incoming>
      <bpmn:outgoing>Flow_Accounts_TechCheck</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_TechCheck" name="Провести полную техническую проверку">
      <bpmn:incoming>Flow_Accounts_TechCheck</bpmn:incoming>
      <bpmn:incoming>Flow_Fix_TechCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_TechCheck_Works</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Works" name="Все позиции работают?">
      <bpmn:incoming>Flow_TechCheck_Works</bpmn:incoming>
      <bpmn:outgoing>Flow_Works_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_Works_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Fix" name="Устранить недостатки">
      <bpmn:incoming>Flow_Works_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Fix_TechCheck</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SendChecklist" name="Передать заполненный чек-лист руководителю">
      <bpmn:incoming>Flow_Works_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_SendChecklist_ManagerReview</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ManagerReview" name="Сверить подготовленный комплект с заявленной потребностью">
      <bpmn:incoming>Flow_SendChecklist_ManagerReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ManagerReview_Credentials</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Credentials" name="Передать временные данные для входа">
      <bpmn:incoming>Flow_ManagerReview_Credentials</bpmn:incoming>
      <bpmn:outgoing>Flow_Credentials_FirstLogin</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_FirstLogin" name="Выполнить первичный вход и заменить временный пароль">
      <bpmn:incoming>Flow_Credentials_FirstLogin</bpmn:incoming>
      <bpmn:outgoing>Flow_FirstLogin_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Ready" name="Подготовка завершена">
      <bpmn:incoming>Flow_FirstLogin_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Checklist" sourceRef="Start_10Days" targetRef="Task_Checklist" />
    <bpmn:sequenceFlow id="Flow_Checklist_CheckEquipment" sourceRef="Task_Checklist" targetRef="Task_CheckEquipment" />
    <bpmn:sequenceFlow id="Flow_CheckEquipment_Gateway" sourceRef="Task_CheckEquipment" targetRef="Gateway_Equipment" />
    <bpmn:sequenceFlow id="Flow_Equipment_Yes" name="Да" sourceRef="Gateway_Equipment" targetRef="Task_Configure" />
    <bpmn:sequenceFlow id="Flow_Equipment_No" name="Нет" sourceRef="Gateway_Equipment" targetRef="Task_PurchaseRequest" />
    <bpmn:sequenceFlow id="Flow_Request_Purchase" sourceRef="Task_PurchaseRequest" targetRef="Call_Purchase" />
    <bpmn:sequenceFlow id="Flow_Purchase_Handover" sourceRef="Call_Purchase" targetRef="Task_HandoverEquipment" />
    <bpmn:sequenceFlow id="Flow_Handover_Configure" sourceRef="Task_HandoverEquipment" targetRef="Task_Configure" />
    <bpmn:sequenceFlow id="Flow_Configure_Accounts" sourceRef="Task_Configure" targetRef="Task_Accounts" />
    <bpmn:sequenceFlow id="Flow_Accounts_TechCheck" sourceRef="Task_Accounts" targetRef="Task_TechCheck" />
    <bpmn:sequenceFlow id="Flow_TechCheck_Works" sourceRef="Task_TechCheck" targetRef="Gateway_Works" />
    <bpmn:sequenceFlow id="Flow_Works_No" name="Нет" sourceRef="Gateway_Works" targetRef="Task_Fix" />
    <bpmn:sequenceFlow id="Flow_Fix_TechCheck" sourceRef="Task_Fix" targetRef="Task_TechCheck" />
    <bpmn:sequenceFlow id="Flow_Works_Yes" name="Да" sourceRef="Gateway_Works" targetRef="Task_SendChecklist" />
    <bpmn:sequenceFlow id="Flow_SendChecklist_ManagerReview" sourceRef="Task_SendChecklist" targetRef="Task_ManagerReview" />
    <bpmn:sequenceFlow id="Flow_ManagerReview_Credentials" sourceRef="Task_ManagerReview" targetRef="Task_Credentials" />
    <bpmn:sequenceFlow id="Flow_Credentials_FirstLogin" sourceRef="Task_Credentials" targetRef="Task_FirstLogin" />
    <bpmn:sequenceFlow id="Flow_FirstLogin_End" sourceRef="Task_FirstLogin" targetRef="End_Ready" />
    <bpmn:startEvent id="Start_Late" name="Дата выхода согласована менее чем за 10 дней до выхода">
      <bpmn:outgoing>Flow_Late_Checklist</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Late_Checklist" sourceRef="Start_Late" targetRef="Task_Checklist" />
    <bpmn:association id="Assoc_Checklist_Create" associationDirection="One" sourceRef="Task_Checklist" targetRef="DataRef_Checklist_Start" />
    <bpmn:association id="Assoc_Checklist_Finalize" associationDirection="One" sourceRef="Task_SendChecklist" targetRef="DataRef_Checklist_Final" />
    <bpmn:association id="Assoc_Request_Create" associationDirection="One" sourceRef="Task_PurchaseRequest" targetRef="DataRef_PurchaseRequest" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_03">
    <bpmndi:BPMNPlane id="BPMNPlane_03" bpmnElement="Process_03">
      <bpmndi:BPMNShape id="Lane_NewEmployee_di" bpmnElement="Lane_NewEmployee" isHorizontal="true">
