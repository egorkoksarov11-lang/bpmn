<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Absence_v2" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="Participant" name="Установление причины отсутствия сотрудника" processRef="P" />
  </bpmn:collaboration>
  <bpmn:process id="P" isExecutable="false">
    <bpmn:laneSet id="LS">
      <bpmn:lane id="L_SB" name="Служба безопасности">
        <bpmn:flowNodeRef>SB_Check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_A" name="Уполномоченное лицо">
        <bpmn:flowNodeRef>A_Decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_A</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_HR" name="Сотрудник отдела кадров">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_ELN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HR_Recheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HR_Sick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Existing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HR_SB_Assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HR_Emergency</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Reason</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_App</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Refuse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_M</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_Return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HR_Existing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HR_ELN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HR_Vac</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Vac</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HR_Change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HR_Discipline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Existing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HR_Clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HR_Existing_Account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ELN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Discipline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ELN2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Formalize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Sick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HR_Formalize</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Сотрудник отсутствует на рабочем месте" />
    <bpmn:userTask id="M_Contact" name="Связаться с сотрудником и уточнить причину отсутствия" />
    <bpmn:exclusiveGateway id="G_Info" name="Причина и местонахождение установлены?" />
    <bpmn:intermediateCatchEvent id="Timer_ELN" name="3 календарных дня">
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="HR_Recheck" name="Повторно проверить поступление сведений об ЭЛН">
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1kviqrt">
        <bpmn:targetRef>DSR_SEDO_2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="HR_Sick" name="Учесть отсутствие как временную нетрудоспособность" />
    <bpmn:endEvent id="End_Existing" name="Отсутствие учтено по оформленному основанию" />
    <bpmn:exclusiveGateway id="G_Contact" name="Сотрудник вышел на связь?" />
    <bpmn:userTask id="HR_SB_Assign" name="Сформировать и направить задание Службе безопасности" />
    <bpmn:userTask id="HR_Emergency" name="Связаться с контактным лицом для экстренной связи" />
    <bpmn:exclusiveGateway id="G_Reason" name="Какое основание отсутствия установлено?" />
    <bpmn:userTask id="M_App" name="Получить заявление сотрудника и согласовать / отклонить">
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0g9izhd">
        <bpmn:targetRef>DR_APP_Manager</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="SB_Check" name="Установить местонахождение сотрудника и обстоятельства отсутствия" />
    <bpmn:dataObjectReference id="DR_SB_Input" name="Задание СБ" dataObjectRef="DO_SB" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="M_Contact" />
    <bpmn:sequenceFlow id="F2" sourceRef="M_Contact" targetRef="G_Contact" />
    <bpmn:sequenceFlow id="F5" sourceRef="HR_Emergency" targetRef="G_Info" />
    <bpmn:sequenceFlow id="F6" name="Да" sourceRef="G_Info" targetRef="G_Reason" />
    <bpmn:sequenceFlow id="F7" name="Нет" sourceRef="G_Info" targetRef="HR_SB_Assign" />
    <bpmn:sequenceFlow id="F10" sourceRef="HR_ELN" targetRef="G_ELN" />
    <bpmn:sequenceFlow id="F11" name="Да" sourceRef="G_ELN" targetRef="HR_Sick" />
    <bpmn:sequenceFlow id="F13" sourceRef="HR_Clarify" targetRef="Timer_ELN" />
    <bpmn:sequenceFlow id="F14" sourceRef="Timer_ELN" targetRef="HR_Recheck" />
    <bpmn:sequenceFlow id="F15" sourceRef="HR_Recheck" targetRef="G_ELN2" />
    <bpmn:sequenceFlow id="F16" name="Да" sourceRef="G_ELN2" targetRef="End_Sick" />
    <bpmn:sequenceFlow id="F17" name="Нет" sourceRef="G_ELN2" targetRef="HR_Discipline" />
    <bpmn:sequenceFlow id="F18" sourceRef="HR_Sick" targetRef="End_Sick" />
    <bpmn:sequenceFlow id="F41" sourceRef="HR_Existing_Account" targetRef="End_Existing" />
    <bpmn:sequenceFlow id="F25" name="Изменение режима / дистанционная работа" sourceRef="G_Reason" targetRef="HR_Change" />
    <bpmn:sequenceFlow id="F28" sourceRef="M_App" targetRef="G_M" />
    <bpmn:sequenceFlow id="F29" name="Да" sourceRef="G_M" targetRef="A_Decide" />
    <bpmn:sequenceFlow id="F32" name="Да" sourceRef="G_A" targetRef="HR_Formalize" />
    <bpmn:sequenceFlow id="F33" name="Нет" sourceRef="G_A" targetRef="M_Refuse" />
    <bpmn:sequenceFlow id="F34" sourceRef="HR_Formalize" targetRef="End_Formalize" />
    <bpmn:sequenceFlow id="F37" name="Да" sourceRef="G_Return" targetRef="End_Return" />
    <bpmn:sequenceFlow id="F38" name="Нет" sourceRef="G_Return" targetRef="HR_Discipline" />
    <bpmn:sequenceFlow id="F22" name="Нет" sourceRef="G_Existing" targetRef="HR_Discipline" />
    <bpmn:sequenceFlow id="F40" name="Причина не установлена" sourceRef="G_Reason" targetRef="HR_Discipline" />
    <bpmn:sequenceFlow id="F39" sourceRef="HR_Discipline" targetRef="End_Discipline" />
    <bpmn:sequenceFlow id="F21" name="Да" sourceRef="G_Existing" targetRef="HR_Existing_Account" />
    <bpmn:sequenceFlow id="F3" name="Да" sourceRef="G_Contact" targetRef="G_Reason" />
    <bpmn:sequenceFlow id="F4" name="Нет" sourceRef="G_Contact" targetRef="HR_Emergency" />
    <bpmn:sequenceFlow id="F7b" sourceRef="HR_SB_Assign" targetRef="SB_Check" />
    <bpmn:sequenceFlow id="F8" sourceRef="SB_Check" targetRef="G_Reason" />
    <bpmn:sequenceFlow id="F9" name="Временная нетрудоспособность" sourceRef="G_Reason" targetRef="HR_ELN" />
    <bpmn:sequenceFlow id="F19" name="Ранее оформленное основание" sourceRef="G_Reason" targetRef="HR_Existing" />
    <bpmn:sequenceFlow id="F23" name="Ежегодный отпуск / изменение дат" sourceRef="G_Reason" targetRef="HR_Vac" />
    <bpmn:sequenceFlow id="F27" name="Иное согласуемое отсутствие" sourceRef="G_Reason" targetRef="M_App" />
    <bpmn:sequenceFlow id="F20" sourceRef="HR_Existing" targetRef="G_Existing" />
    <bpmn:exclusiveGateway id="G_Return" name="Сотрудник приступил к работе?" />
    <bpmn:userTask id="M_Refuse" name="Сообщить об отказе и сроке прибытия на работу" />
    <bpmn:exclusiveGateway id="G_M" name="Руководитель согласовал?" />
    <bpmn:intermediateCatchEvent id="Timer_Return" name="Срок прибытия сотрудника">
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="F36" sourceRef="Timer_Return" targetRef="G_Return" />
    <bpmn:sequenceFlow id="F30" name="Нет" sourceRef="G_M" targetRef="M_Refuse" />
    <bpmn:sequenceFlow id="F35" sourceRef="M_Refuse" targetRef="Timer_Return" />
    <bpmn:endEvent id="End_Return" name="Сотрудник приступил к работе" />
    <bpmn:dataStoreReference id="DSR_SEDO_1" name="СЭДО" dataStoreRef="DS_SEDO" />
    <bpmn:userTask id="HR_Existing" name="Проверить ранее оформленное основание в документах и 1С:ЗУП">
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1kb1as9">
        <bpmn:targetRef>DSR_1C_Existing</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:dataObjectReference id="DR_APP_Manager" name="Заявление решение руководителя" dataObjectRef="DO_APP" />
    <bpmn:userTask id="HR_ELN" name="Проверить поступление сведений об ЭЛН через СЭДО">
      <bpmn:dataOutputAssociation id="DataOutputAssociation_10ud5ir">
        <bpmn:targetRef>DSR_SEDO_1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:dataObjectReference id="DR_APP_Input" name="Заявление о согласовании отсутствия" dataObjectRef="DO_APP" />
    <bpmn:sequenceFlow id="F26" sourceRef="HR_Change" targetRef="End_Change" />
    <bpmn:sequenceFlow id="F24" sourceRef="HR_Vac" targetRef="End_Vac" />
    <bpmn:userTask id="HR_Vac" name="Запустить процесс «Предоставление отпуска сотруднику»" />
    <bpmn:endEvent id="End_Vac" name="Передано в процесс предоставления отпуска" />
    <bpmn:endEvent id="End_Change" name="Передано в процесс изменения условий труда" />
    <bpmn:userTask id="HR_Change" name="Запустить процесс «Изменение условий труда и кадровое перемещение сотрудника»" />
    <bpmn:userTask id="HR_Discipline" name="Зафиксировать неподтвержденное отсутствие и запустить процесс «Рассмотрение дисциплинарного проступка сотрудника»" />
    <bpmn:dataStoreReference id="DSR_1C_Existing" name="1С:ЗУП" dataStoreRef="DS_1C8" />
    <bpmn:exclusiveGateway id="G_Existing" name="Основание подтверждено?" />
    <bpmn:sequenceFlow id="F31" sourceRef="A_Decide" targetRef="G_A" />
    <bpmn:userTask id="A_Decide" name="Согласовать / отклонить заявление сотрудника" />
    <bpmn:dataObjectReference id="DR_APP_AuthInput" name="Заявление о согласовании отсутствия" dataObjectRef="DO_APP" />
    <bpmn:dataObjectReference id="DR_APP_AuthResult" name="Заявление - решение уполномоченного лица" dataObjectRef="DO_APP" />
    <bpmn:exclusiveGateway id="G_A" name="Согласовано?" />
    <bpmn:userTask id="HR_Clarify" name="Уточнить факт обращения в медорганизацию и необходимость подтверждения" />
    <bpmn:userTask id="HR_Existing_Account" name="Учесть отсутствие в соответствии с оформленным основанием" />
    <bpmn:exclusiveGateway id="G_ELN" name="Сведения об ЭЛН поступили?" />
    <bpmn:sequenceFlow id="F12" name="Нет" sourceRef="G_ELN" targetRef="HR_Clarify" />
    <bpmn:dataObjectReference id="DR_SB_Result_Discipline" name="Задание СБ  результат проверки" dataObjectRef="DO_SB" />
    <bpmn:endEvent id="End_Discipline" name="Передано на рассмотрение дисциплинарного проступка" />
    <bpmn:dataObjectReference id="DR_APP_HR" name="Согласованное заявление" dataObjectRef="DO_APP" />
    <bpmn:dataObject id="DO_APP" />
    <bpmn:exclusiveGateway id="G_ELN2" name="Нетрудоспособность подтверждена?" />
    <bpmn:endEvent id="End_Formalize" name="Отсутствие оформлено" />
    <bpmn:endEvent id="End_Sick" name="Нетрудоспособность подтверждена">
      <bpmn:incoming>F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DSR_SEDO_2" name="СЭДО" dataStoreRef="DS_SEDO" />
    <bpmn:userTask id="HR_Formalize" name="Оформить отсутствие по согласованному основанию">
      <bpmn:property id="Property_1ukv5gf" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_1xo96r1">
        <bpmn:sourceRef>DR_APP_HR</bpmn:sourceRef>
        <bpmn:targetRef>Property_1ukv5gf</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:dataObjectReference id="DR_SB_Create" name="Задание СБ" dataObjectRef="DO_SB" />
    <bpmn:dataObject id="DO_SB" />
    <bpmn:association id="A_SB_Input" associationDirection="One" sourceRef="DR_SB_Input" targetRef="SB_Check" />
    <bpmn:association id="A_APP_Input" associationDirection="One" sourceRef="DR_APP_Input" targetRef="M_App" />
    <bpmn:association id="A_APP_AuthInput" associationDirection="One" sourceRef="DR_APP_AuthInput" targetRef="A_Decide" />
    <bpmn:association id="A_APP_AuthResult" associationDirection="One" sourceRef="A_Decide" targetRef="DR_APP_AuthResult" />
    <bpmn:association id="A_SB_Result_Discipline" associationDirection="One" sourceRef="DR_SB_Result_Discipline" targetRef="HR_Discipline" />
    <bpmn:association id="A_SB_Create" associationDirection="One" sourceRef="HR_SB_Assign" targetRef="DR_SB_Create" />
  </bpmn:process>
