<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:process id="Process_Military_Onboarding" name="Воинский учет при приеме сотрудника" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_HR" name="Кадровик">
        <bpmn:flowNodeRef>Task_CheckApplicability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnOriginals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompareData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyEmployee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Form10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportDiscrepancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NotApplicable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Discrepancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NotRegistered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Applicable</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_08eleo7" name="Сотрудник">
        <bpmn:flowNodeRef>Task_PresentDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClarifyData</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Прием сотрудника оформлен">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_CheckApplicability" name="Определить применимость воинского учета">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1du73eh">
        <bpmn:targetRef>DataStoreReference_054rv06</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Applicable" name="Подлежит воинскому учету?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3Y</bpmn:outgoing>
      <bpmn:outgoing>F3N</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_NotApplicable" name="Воинский учет не применяется">
      <bpmn:incoming>F3N</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_PresentDocs" name="Предъявить паспорт и документ воинского учета">
      <bpmn:incoming>F3Y</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CheckDocs" name="Проверить документы и военно-учетные отметки">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReturnOriginals" name="Вернуть оригиналы паспорта и документа воинского учета">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F5b</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_09x02zi">
        <bpmn:targetRef>DataObjectReference_1xd5mmc</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_12sx7hs">
        <bpmn:targetRef>DataObjectReference_0yvjvzd</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_CompareData" name="Сопоставить сведения с 1С:ЗУП">
      <bpmn:incoming>F5b</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_13zjx05">
        <bpmn:targetRef>DataStoreReference_1m4u9pz</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_ClarifyData" name="Сообщить отсутствующие / актуальные сведения">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Discrepancy" name="Есть обстоятельства для сообщения в военкомат?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8Y</bpmn:outgoing>
      <bpmn:outgoing>F8N</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ReportDiscrepancy" name="Зафиксировать расхождение и направить сообщение">
      <bpmn:incoming>F8Y</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_NotRegistered" name="Обязан состоять на учете, но не состоит?">
      <bpmn:incoming>F8N</bpmn:incoming>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10Y</bpmn:outgoing>
      <bpmn:outgoing>F10N</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_NotifyEmployee" name="Проинформировать о постановке на учет и поставить на контроль">
      <bpmn:incoming>F10Y</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Form10" name="Оформить карточку формы № 10">
      <bpmn:incoming>F10N</bpmn:incoming>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0smsuax">
        <bpmn:targetRef>DataStoreReference_06msvpy</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1vuse74">
        <bpmn:targetRef>DR_Military_Form10</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_SendInfo" name="Сформировать и направить сведения о приеме">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_077tzps">
        <bpmn:targetRef>DataStoreReference_0es3csc</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_RecordResult" name="Зафиксировать результат и сохранить подтверждение">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0r0m7zy">
        <bpmn:targetRef>DataStoreReference_0lt40vj</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="End_Done" name="Мероприятия выполнены; контрольные действия отслеживаются">
      <bpmn:incoming>F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="DataRef_Form10" name="Форма № 10" dataObjectRef="Data_Form10" />
    <bpmn:dataObject id="Data_Info" name="Сведения о гражданине при принятии на работу" />
    <bpmn:dataObjectReference id="DataRef_Info" name="Сведения о гражданине" dataObjectRef="Data_Info" />
    <bpmn:dataObject id="Data_MilitaryDoc" name="Оригинал документа воинского учета" />
    <bpmn:dataObjectReference id="DR_Military_Input" name="Документ воинского учета" dataObjectRef="Data_MilitaryDoc" />
    <bpmn:dataObjectReference id="DR_Military_Form10" name="Документ воинского учета" dataObjectRef="Data_MilitaryDoc" />
    <bpmn:sequenceFlow id="F1" sourceRef="StartEvent_1" targetRef="Task_CheckApplicability" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_CheckApplicability" targetRef="Gateway_Applicable" />
    <bpmn:sequenceFlow id="F3Y" name="Да" sourceRef="Gateway_Applicable" targetRef="Task_PresentDocs" />
    <bpmn:sequenceFlow id="F3N" name="Нет" sourceRef="Gateway_Applicable" targetRef="End_NotApplicable" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_PresentDocs" targetRef="Task_CheckDocs" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_CheckDocs" targetRef="Task_ReturnOriginals" />
    <bpmn:sequenceFlow id="F5b" sourceRef="Task_ReturnOriginals" targetRef="Task_CompareData" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_CompareData" targetRef="Task_ClarifyData" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_ClarifyData" targetRef="Gateway_Discrepancy" />
    <bpmn:sequenceFlow id="F8Y" name="Да" sourceRef="Gateway_Discrepancy" targetRef="Task_ReportDiscrepancy" />
    <bpmn:sequenceFlow id="F8N" name="Нет" sourceRef="Gateway_Discrepancy" targetRef="Gateway_NotRegistered" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_ReportDiscrepancy" targetRef="Gateway_NotRegistered" />
    <bpmn:sequenceFlow id="F10Y" name="Да" sourceRef="Gateway_NotRegistered" targetRef="Task_NotifyEmployee" />
    <bpmn:sequenceFlow id="F10N" name="Нет" sourceRef="Gateway_NotRegistered" targetRef="Task_Form10" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_NotifyEmployee" targetRef="Task_Form10" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Form10" targetRef="Task_SendInfo" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_SendInfo" targetRef="Task_RecordResult" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_RecordResult" targetRef="End_Done" />
