    <bpmn:sequenceFlow id="F25" name="Да" sourceRef="Gateway_Vacancies" targetRef="Task_OfferVacancies" />
    <bpmn:sequenceFlow id="F26" name="Нет" sourceRef="Gateway_Vacancies" targetRef="Task_MonitorVacancies" />
    <bpmn:sequenceFlow id="F27" sourceRef="Task_OfferVacancies" targetRef="Gateway_Accepted" />
