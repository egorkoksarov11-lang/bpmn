<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_StaffReduction" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Main" name="Организация" processRef="Process_StaffReduction" />
    <bpmn:participant id="Participant_Employment" name="Государственная служба занятости" />
    <bpmn:messageFlow id="MessageFlow_Employment" sourceRef="Task_NotifyEmployment" targetRef="Participant_Employment" />
  </bpmn:collaboration>
  <bpmn:process id="Process_StaffReduction" name="Сокращение численности и штата" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Manager" name="Руководитель подразделения">
        <bpmn:flowNodeRef>Task_PrepareProject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="HR">
        <bpmn:flowNodeRef>Task_CheckVacancies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Vacancies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Transfer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MonitorVacancies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PeriodEnded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckScope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckRestrictions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_LegalNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CanContinue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CompareNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Stop</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Personnel" name="Кадровик">
        <bpmn:flowNodeRef>Task_NotifyEmployment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WarnEmployee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Refusal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareStaffOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RefusalAct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FormDismissalPackage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OfferVacancies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Dismissal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Authorized" name="Уполномоченное лицо">
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignStaffOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DecideProject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ProjectDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Lawyer" name="Юрист">
        <bpmn:flowNodeRef>Task_LegalReview</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:endEvent id="EndEvent_Rejected" name="Проект отклонен" />
    <bpmn:task id="Task_SignStaffOrder" name="Подписать приказ">
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0237b09">
        <bpmn:targetRef>DataRef_T3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_NotifyEmployment" name="5.7 Направить сведения в службу занятости" />
    <bpmn:task id="Task_WarnEmployee" name="5.8 Подготовить и вручить персональное предупреждение" />
    <bpmn:exclusiveGateway id="Gateway_Refusal" name="Отказ от получения / подписи?" />
    <bpmn:exclusiveGateway id="Gateway_Vacancies" name="Есть подходящие вакансии?" />
    <bpmn:exclusiveGateway id="Gateway_Accepted" name="Работник согласен на перевод?" />
    <bpmn:endEvent id="EndEvent_Transfer" name="Передача в процесс кадрового перемещения" />
    <bpmn:task id="Task_MonitorVacancies" name="5.10 Контролировать появление новых вакансий" />
    <bpmn:exclusiveGateway id="Gateway_PeriodEnded" name="Срок предупреждения истек?" />
    <bpmn:dataObjectReference id="DataRef_Vacancies_Check" name="Предложение вакансий" dataObjectRef="Data_Vacancies" />
    <bpmn:task id="Task_PrepareProject" name="5.1 Подготовить проект изменения совместно с HR">
      <bpmn:property id="Property_1w587f0" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_0bv6lv3">
        <bpmn:targetRef>Property_1w587f0</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:startEvent id="StartEvent_1" name="Возникла необходимость изменения структуры / численности" />
    <bpmn:task id="Task_DecideProject" name="5.2 Рассмотреть проект и зафиксировать решение" />
    <bpmn:exclusiveGateway id="Gateway_ProjectDecision" name="Решение?" />
    <bpmn:dataObjectReference id="DataRef_Vacancies_Transfer" name="Предложение вакансий / письменное согласие" dataObjectRef="Data_Vacancies" />
    <bpmn:dataObjectReference id="DataRef_Project_Prepare" name="Проект изменения структуры" dataObjectRef="Data_Project" />
    <bpmn:sequenceFlow id="F6" name="Отклонить" sourceRef="Gateway_ProjectDecision" targetRef="EndEvent_Rejected" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_CheckScope" targetRef="Task_CheckRestrictions" />
    <bpmn:sequenceFlow id="Flow_1tri2u8" sourceRef="Task_CheckRestrictions" targetRef="Gateway_LegalNeeded" />
    <bpmn:sequenceFlow id="F10" name="Нет" sourceRef="Gateway_LegalNeeded" targetRef="Gateway_CanContinue" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_LegalReview" targetRef="Gateway_CanContinue" />
    <bpmn:sequenceFlow id="F12" name="Нет" sourceRef="Gateway_CanContinue" targetRef="EndEvent_Stop" />
    <bpmn:sequenceFlow id="F13" name="Да" sourceRef="Gateway_CanContinue" targetRef="Gateway_CompareNeeded" />
