    <bpmn:sequenceFlow id="F29" name="Нет" sourceRef="Gateway_Accepted" targetRef="Task_MonitorVacancies" />
    <bpmn:sequenceFlow id="F30" sourceRef="Task_MonitorVacancies" targetRef="Gateway_PeriodEnded" />
    <bpmn:sequenceFlow id="F32" name="Да" sourceRef="Gateway_PeriodEnded" targetRef="Task_FormDismissalPackage" />
    <bpmn:sequenceFlow id="F1" sourceRef="StartEvent_1" targetRef="Task_PrepareProject" />
    <bpmn:sequenceFlow id="F5" name="На доработку" sourceRef="Gateway_ProjectDecision" targetRef="Task_PrepareProject" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_PrepareProject" targetRef="Task_DecideProject" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_DecideProject" targetRef="Gateway_ProjectDecision" />
    <bpmn:sequenceFlow id="F4" name="Утвердить" sourceRef="Gateway_ProjectDecision" targetRef="Task_CheckScope" />
    <bpmn:sequenceFlow id="F9" name="Да" sourceRef="Gateway_LegalNeeded" targetRef="Task_LegalReview" />
    <bpmn:task id="Task_CheckScope" name="5.3 Определить характер и масштаб сокращения" />
    <bpmn:task id="Task_CheckRestrictions" name="5.4 Проверить ограничения и гарантии">
      <bpmn:outgoing>Flow_1tri2u8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_LegalNeeded" name="Нужна правовая оценка?">
      <bpmn:incoming>Flow_1tri2u8</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_LegalReview" name="Провести правовую оценку" />
    <bpmn:exclusiveGateway id="Gateway_CanContinue" name="Процедуру можно продолжить?" />
    <bpmn:exclusiveGateway id="Gateway_CompareNeeded" name="Нужно сравнение работников?" />
    <bpmn:task id="Task_Compare" name="5.5 Оценить преимущественное право" />
