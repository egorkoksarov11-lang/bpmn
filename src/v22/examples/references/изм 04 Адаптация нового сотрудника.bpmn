    <bpmn:startEvent id="start" name="Первый рабочий день сотрудника">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="a" name="Провести вводную встречу">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="b" name="Познакомить с подразделением и рабочими процессами">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="c" name="Сформировать задачи и контрольные точки в документе по адаптации">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="d" name="Выполнять задачи и фиксировать результаты">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1rbdui4">
        <bpmn:targetRef>DOR_Adapt_Work</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="e" name="Контролировать выполнение и давать обратную связь">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="f" name="Сопровождать адаптацию и помогать устранять затруднения">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="h" name="Провести промежуточную оценку">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="h_emp" name="Ознакомиться с промежуточной обратной связью и при необходимости дать комментарий">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="k" name="Сформировать итоговую оценку">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="l" name="Ознакомиться с итоговой оценкой и при наличии дать комментарий">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="m" name="Проверить документ по адаптации и основания итогового вывода">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="n" name="Итоговая оценка положительная?">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="q" name="Рассмотреть документ по адаптации и принять решение">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="r" name="Продолжить трудовые отношения?">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="o" name="Зафиксировать итог прохождения адаптации и обеспечить хранение документа">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="o_term" name="Зафиксировать итог прохождения адаптации и обеспечить хранение документа">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="p" name="Сотрудник продолжает работу">
      <bpmn:incoming>F23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="t" name="Запустить процесс прекращения трудового договора">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="u" name="Адаптация завершена">
      <bpmn:incoming>F22</bpmn:incoming>
    </bpmn:endEvent>
