  <bpmn:dataStore id="DS_1C" name="1С:ЗУП" />
  <bpmn:dataStore id="DS_SEDO" name="СЭДО СФР" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Оформление временной нетрудоспособности сотрудника" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Accounting" name="Бухгалтерия">
        <bpmn:flowNodeRef>DeterminePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PrepareSFR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_SFROK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RequestHRCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RecordAcceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CorrectCalc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendCorrected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_HRCorrection</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="Кадровик">
        <bpmn:flowNodeRef>G_OtherBasis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CorrectHR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinalHR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_Cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CallAbsence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_Close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CreateSick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_DataOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CloseELN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Extend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_Extend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Resolve</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:exclusiveGateway id="G_OtherBasis" name="Есть иное подтвержденное основание отсутствия?" />
    <bpmn:endEvent id="EndCancel" name="Аннулирование обработано" />
    <bpmn:userTask id="DeterminePayment" name="Определить порядок оплаты и рассчитать выплату работодателя" />
    <bpmn:userTask id="PrepareSFR" name="Проверить и передать / подтвердить необходимые сведения для СФР не позднее 3 рабочих дней" />
    <bpmn:exclusiveGateway id="G_SFROK" name="Сведения приняты без необходимости уточнения?" />
    <bpmn:userTask id="RequestHRCorrection" name="Передать кадровику перечень выявленных расхождений" />
    <bpmn:userTask id="CorrectHR" name="Проверить и скорректировать кадровые данные в 1С:ЗУП" />
    <bpmn:userTask id="RecordAcceptance" name="Зафиксировать результат обработки сведений" />
    <bpmn:userTask id="FinalHR" name="Сохранить окончательный статус и период нетрудоспособности в 1С:ЗУП" />
    <bpmn:endEvent id="End" name="Временная нетрудоспособность оформлена" />
    <bpmn:dataStoreReference id="SR_1C_Payment" name="1С:ЗУП" dataStoreRef="DS_1C" />
    <bpmn:dataStoreReference id="SR_1C_CorrectHR" name="1С:ЗУП" dataStoreRef="DS_1C" />
    <bpmn:dataStoreReference id="SR_SEDO_Prepare" name="СЭДО СФР" dataStoreRef="DS_SEDO" />
    <bpmn:dataStoreReference id="SR_SEDO_Record" name="СЭДО СФР" dataStoreRef="DS_SEDO" />
    <bpmn:userTask id="Cancel" name="Скорректировать кадровый учет по актуальным сведениям" />
    <bpmn:dataStoreReference id="SR_1C_Cancel" name="1С:ЗУП" dataStoreRef="DS_1C" />
    <bpmn:intermediateCatchEvent id="Ev_Cancel" name="ЭЛН аннулирован">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:callActivity id="CallAbsence" name="Установление причины отсутствия сотрудника" calledElement="Process_Absence" />
    <bpmn:dataStoreReference id="SR_1C_Final" name="1С:ЗУП" dataStoreRef="DS_1C" />
    <bpmn:intermediateCatchEvent id="Ev_Close" name="ЭЛН закрыт">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="G_Status" name="Ожидать изменение статуса ЭЛН" />
    <bpmn:userTask id="CreateSick" name="Создать документ «Больничный лист» в 1С:ЗУП" />
    <bpmn:exclusiveGateway id="G_DataOK" name="Сведения корректны и противоречий нет?" />
    <bpmn:userTask id="Identify" name="Идентифицировать сотрудника и сопоставить ЭЛН с кадровыми данными" />
    <bpmn:startEvent id="Start" name="Поступили сведения об открытии ЭЛН" />
    <bpmn:dataStoreReference id="SR_1C_Close" name="1С:ЗУП" dataStoreRef="DS_1C" />
    <bpmn:userTask id="CloseELN" name="Сверить окончательные даты и закрыть оформление больничного в 1С:ЗУП" />
    <bpmn:dataStoreReference id="SR_1C_Extend" name="1С:ЗУП" dataStoreRef="DS_1C" />
    <bpmn:userTask id="Extend" name="Обновить период временной нетрудоспособности в 1С:ЗУП" />
    <bpmn:intermediateCatchEvent id="Ev_Extend" name="ЭЛН продлен">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Resolve" name="Установить и устранить причину расхождения" />
    <bpmn:dataStoreReference id="SR_1C_Create" name="1С:ЗУП" dataStoreRef="DS_1C" />
    <bpmn:dataStoreReference id="SR_1C_Identify" name="1С:ЗУП" dataStoreRef="DS_1C" />
    <bpmn:sequenceFlow id="F13" sourceRef="Cancel" targetRef="G_OtherBasis" />
