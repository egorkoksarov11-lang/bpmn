<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Timekeeping" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Main" name="Табелирование и учет рабочего времени" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_HR" name="Кадровик">
        <bpmn:flowNodeRef>Timer_MonthEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Control</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Deviation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1C" name="1С:ЗУП">
        <bpmn:flowNodeRef>Task_Absence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Auto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_122kvd5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_LateCorrection</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:intermediateCatchEvent id="Timer_MonthEnd" name="Окончание отчетного месяца">
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_Absence" name="5.2 Учесть результат процесса «Внеплановое отсутствие сотрудника»">
      <bpmn:incoming>Flow_1jgazor</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Auto" name="5.1 Автоматически формировать данные учета рабочего времени" />
    <bpmn:startEvent id="Start_1" name="Начало отчетного месяца" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Absence" targetRef="Timer_MonthEnd" />
    <bpmn:sequenceFlow id="F4" sourceRef="Timer_MonthEnd" targetRef="Task_Control" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Update" targetRef="Task_Control" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Control" targetRef="Gateway_Deviation" />
    <bpmn:sequenceFlow id="F6" name="Нет" sourceRef="Gateway_Deviation" targetRef="Task_Final" />
    <bpmn:sequenceFlow id="F7" name="Да" sourceRef="Gateway_Deviation" targetRef="Task_Send" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Send" targetRef="Task_Update" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Final" targetRef="End_1" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Auto" targetRef="Timer_MonthEnd" />
    <bpmn:sequenceFlow id="Flow_1jgazor" sourceRef="Event_122kvd5" targetRef="Task_Absence" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Auto" />
    <bpmn:sequenceFlow id="F11" sourceRef="Start_LateCorrection" targetRef="Task_Update" />
    <bpmn:dataObjectReference id="DR_AbsenceResult" name="Оформленный документ из процесса «Внеплановое отсутствие сотрудника»" dataObjectRef="DO_AbsenceResult" />
    <bpmn:dataObject id="DO_AbsenceResult" name="Результат процесса «Внеплановое отсутствие сотрудника»" />
    <bpmn:startEvent id="Event_122kvd5" name="Оформленное основание отсутствия">
      <bpmn:outgoing>Flow_1jgazor</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_Deviation" name="Есть необработанные отклонения?" />
    <bpmn:task id="Task_Send" name="Передать отклонение в соответствующий кадровый процесс" />
    <bpmn:task id="Task_Final" name="5.4 Сформировать итоговый табель">
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0mi9jqs">
        <bpmn:targetRef>DR_Timesheet</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObjectReference id="DR_Timesheet" name="Табель учета рабочего времени (Т-13)" dataObjectRef="DO_Timesheet" />
    <bpmn:dataObject id="DO_Timesheet" />
    <bpmn:endEvent id="End_1" name="Итоговый табель сформирован" />
    <bpmn:task id="Task_Update" name="Актуализировать данные после оформления основания" />
    <bpmn:startEvent id="Start_LateCorrection" name="Оформлен документ за прошедший отчетный период" />
    <bpmn:task id="Task_Control" name="5.3 Проверить необработанные отклонения" />
    <bpmn:association id="A_AbsenceInput" associationDirection="One" sourceRef="DR_AbsenceResult" targetRef="Task_Absence" />
  </bpmn:process>
