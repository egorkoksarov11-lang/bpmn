<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_LNA" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:process id="Process_LNA" name="Создание, изменение, утверждение и доведение ЛНА" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_HR" name="Кадровик">
        <bpmn:flowNodeRef>Task_Acquaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Lawyer" name="Юрист">
        <bpmn:flowNodeRef>Task_LegalReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Legal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Interested" name="Заинтересованные должностные лица">
        <bpmn:flowNodeRef>Task_ReviewInterested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Comments</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Owner" name="Владелец документа">
        <bpmn:flowNodeRef>Task_Draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessComments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixLegal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Package</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendLawyer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendHR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Recheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Auth" name="Уполномоченное лицо">
        <bpmn:flowNodeRef>Task_DecideNeed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoNeed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Approve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Init" name="Инициатор изменения">
        <bpmn:flowNodeRef>Task_Initiative</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Возникла необходимость создать / изменить ЛНА" />
    <bpmn:task id="Task_Initiative" name="Сформировать инициативу и требования" />
    <bpmn:task id="Task_DecideNeed" name="Рассмотреть инициативу, определить необходимость и владельца" />
    <bpmn:exclusiveGateway id="Gw_Need" name="Разработка требуется?" />
    <bpmn:endEvent id="End_NoNeed" name="Инициатива прекращена" />
    <bpmn:task id="Task_Draft" name="Подготовить проект ЛНА" />
    <bpmn:task id="Task_Route" name="Определить заинтересованных лиц и маршрут согласования" />
    <bpmn:task id="Task_ReviewInterested" name="Одновременно рассмотреть проект и дать согласование / замечания" />
    <bpmn:exclusiveGateway id="Gw_Comments" name="Есть замечания?" />
    <bpmn:task id="Task_ProcessComments" name="Обработать замечания: доработать проект или мотивировать неустранение" />
    <bpmn:exclusiveGateway id="Gw_Recheck" name="Нужно повторное согласование изменённых положений?" />
    <bpmn:task id="Task_ReReview" name="Повторно рассмотреть изменённые положения" />
    <bpmn:task id="Task_SendLawyer" name="Передать юристу проект, замечания и результаты их рассмотрения">
      <bpmn:incoming>Flow_1b4n28i</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Task_LegalReview" name="Проверить проект и согласовать / дать замечания" />
    <bpmn:exclusiveGateway id="Gw_Legal" name="Есть замечания юриста?" />
    <bpmn:task id="Task_FixLegal" name="Устранить замечания юриста" />
    <bpmn:task id="Task_Package" name="Сформировать окончательный комплект на утверждение">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>Flow_1b4n28i</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Approve" name="Рассмотреть комплект и принять решение" />
    <bpmn:exclusiveGateway id="Gw_Approve" name="Утвердить?" />
    <bpmn:task id="Task_Publish" name="Разместить действующую редакцию; предыдущую передать в архив" />
    <bpmn:task id="Task_SendHR" name="Передать кадровику ЛНА и перечень работников для ознакомления" />
    <bpmn:task id="Task_Acquaint" name="Организовать и зафиксировать ознакомление работников" />
    <bpmn:endEvent id="End_Done" name="ЛНА введён в действие и доведён до работников" />
    <bpmn:dataObjectReference id="Data_Assignment" name="Задание на создание / изменение ЛНА" dataObjectRef="DO_Assignment" />
    <bpmn:dataObject id="DO_Assignment" />
    <bpmn:dataObjectReference id="Data_ApprovalSheet" name="Лист согласования ЛНА" dataObjectRef="DO_ApprovalSheet" />
    <bpmn:dataObject id="DO_ApprovalSheet" />
    <bpmn:dataObjectReference id="Data_Approval" name="Утверждение ЛНА" dataObjectRef="DO_Approval" />
    <bpmn:dataObject id="DO_Approval" />
    <bpmn:dataObjectReference id="Data_Acquaint" name="Электронное задание на ознакомление" dataObjectRef="DO_Acquaint" />
    <bpmn:dataObject id="DO_Acquaint" />
    <bpmn:dataObjectReference id="Data_Assignment_Initiative" name="Задание на создание / изменение ЛНА" dataObjectRef="DO_Assignment" />
    <bpmn:dataObjectReference id="Data_ApprovalSheet_Interested" name="Лист согласования ЛНА" dataObjectRef="DO_ApprovalSheet" />
    <bpmn:dataObjectReference id="Data_ApprovalSheet_ReReview" name="Лист согласования ЛНА" dataObjectRef="DO_ApprovalSheet" />
    <bpmn:dataObjectReference id="Data_Approval_Package" name="Утверждение ЛНА" dataObjectRef="DO_Approval" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Initiative" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Initiative" targetRef="Task_DecideNeed" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_DecideNeed" targetRef="Gw_Need" />
    <bpmn:sequenceFlow id="F4" name="Нет" sourceRef="Gw_Need" targetRef="End_NoNeed" />
    <bpmn:sequenceFlow id="F5" name="Да" sourceRef="Gw_Need" targetRef="Task_Draft" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Draft" targetRef="Task_Route" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Route" targetRef="Task_ReviewInterested" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_ReviewInterested" targetRef="Gw_Comments" />
    <bpmn:sequenceFlow id="F9" name="Нет" sourceRef="Gw_Comments" targetRef="Task_SendLawyer" />
    <bpmn:sequenceFlow id="F10" name="Да" sourceRef="Gw_Comments" targetRef="Task_ProcessComments" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_ProcessComments" targetRef="Gw_Recheck" />
    <bpmn:sequenceFlow id="F12" name="Да" sourceRef="Gw_Recheck" targetRef="Task_ReReview" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_ReReview" targetRef="Task_ProcessComments" />
    <bpmn:sequenceFlow id="F14" name="Нет" sourceRef="Gw_Recheck" targetRef="Task_Package" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_SendLawyer" targetRef="Task_LegalReview" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_LegalReview" targetRef="Gw_Legal" />
    <bpmn:sequenceFlow id="F17" name="Да" sourceRef="Gw_Legal" targetRef="Task_FixLegal" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_FixLegal" targetRef="Task_LegalReview" />
    <bpmn:sequenceFlow id="F19" name="Нет" sourceRef="Gw_Legal" targetRef="Task_Package" />
    <bpmn:sequenceFlow id="F20" sourceRef="Task_Package" targetRef="Task_Approve" />
    <bpmn:sequenceFlow id="F21" sourceRef="Task_Approve" targetRef="Gw_Approve" />
    <bpmn:sequenceFlow id="F22" name="Нет, вернуть на доработку" sourceRef="Gw_Approve" targetRef="Task_Draft" />
    <bpmn:sequenceFlow id="F23" name="Да" sourceRef="Gw_Approve" targetRef="Task_Publish" />
    <bpmn:sequenceFlow id="F24" sourceRef="Task_Publish" targetRef="Task_SendHR" />
    <bpmn:sequenceFlow id="F25" sourceRef="Task_SendHR" targetRef="Task_Acquaint" />
    <bpmn:sequenceFlow id="F26" sourceRef="Task_Acquaint" targetRef="End_Done" />
    <bpmn:sequenceFlow id="Flow_1b4n28i" sourceRef="Task_Package" targetRef="Task_SendLawyer" />
    <bpmn:association id="Assoc_Assignment" associationDirection="One" sourceRef="Data_Assignment" targetRef="Task_DecideNeed" />
    <bpmn:association id="Assoc_Sheet" associationDirection="One" sourceRef="Data_ApprovalSheet" targetRef="Task_LegalReview" />
    <bpmn:association id="Assoc_Approval" associationDirection="One" sourceRef="Task_Approve" targetRef="Data_Approval" />
    <bpmn:association id="Assoc_Acquaint" associationDirection="One" sourceRef="Task_Acquaint" targetRef="Data_Acquaint" />
    <bpmn:association id="Assoc_Assignment_Initiative" associationDirection="One" sourceRef="Task_Initiative" targetRef="Data_Assignment_Initiative" />
    <bpmn:association id="Assoc_Sheet_Interested" associationDirection="One" sourceRef="Task_ReviewInterested" targetRef="Data_ApprovalSheet_Interested" />
    <bpmn:association id="Assoc_Sheet_ReReview" associationDirection="One" sourceRef="Task_ReReview" targetRef="Data_ApprovalSheet_ReReview" />
    <bpmn:association id="Assoc_Approval_Package" associationDirection="One" sourceRef="Task_Package" targetRef="Data_Approval_Package" />
  </bpmn:process>
