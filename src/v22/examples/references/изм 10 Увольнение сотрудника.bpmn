<?xml version="1.0" encoding="UTF-8"?>
<ns0:definitions xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Uvolnenie" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <ns0:dataStore id="DS_1C" name="1С:ЗУП" />
  <ns0:dataStore id="DS_TaskSystem" name="Система передачи заданий" />
  <ns0:dataStore id="DS_Property" name="Реестр закрепленного имущества" />
  <ns0:dataStore id="DS_ITAccess" name="Реестр ИТ-доступов" />
  <ns0:dataStore id="DS_SFR" name="СФР" />
  <ns0:process id="Process_Uvolnenie" name="Увольнение сотрудника" isExecutable="false">
    <ns0:laneSet id="LaneSet_1">
      <ns0:lane id="Lane_8" name="Ответственный за воинский учет">
        <ns0:flowNodeRef>T_MilPrep</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_MilSend</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_7" name="ИТ-специалист / администратор">
        <ns0:flowNodeRef>T_ITPrep</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_ITBlock</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_6" name="Бухгалтерия">
        <ns0:flowNodeRef>T_Account</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_Pay</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_SFR</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_5" name="Непосредственный руководитель">
        <ns0:flowNodeRef>T_ManagerConfirm</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_Manager</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_4" name="Уполномоченное лицо">
        <ns0:flowNodeRef>T_SignOrder</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_EarlyDecision</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_SignAgr</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_3" name="Директор по персоналу">
        <ns0:flowNodeRef>T_HRCheck</ns0:flowNodeRef>
        <ns0:flowNodeRef>G_DocsOk</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_2" name="Кадровик">
        <ns0:flowNodeRef>Start</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_Class</ns0:flowNodeRef>
        <ns0:flowNodeRef>G_Basis</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_App</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_Date</ns0:flowNodeRef>
        <ns0:flowNodeRef>G_Early</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_EarlyDoc</ns0:flowNodeRef>
        <ns0:flowNodeRef>G_EarlyOk</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_DateStd</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_DateEarly</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_Proposal</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_Agreement</ns0:flowNodeRef>
        <ns0:flowNodeRef>G_AgrSigned</ns0:flowNodeRef>
        <ns0:flowNodeRef>End_NoAgr</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_Fixed</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_Employer</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_Other</ns0:flowNodeRef>
        <ns0:flowNodeRef>G_DateFixed</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_Control</ns0:flowNodeRef>
        <ns0:flowNodeRef>G_ParSplit</ns0:flowNodeRef>
        <ns0:flowNodeRef>G_Mil</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_Order</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_ZUP</ns0:flowNodeRef>
        <ns0:flowNodeRef>G_DaySplit</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_EmployeeDocs</ns0:flowNodeRef>
        <ns0:flowNodeRef>G_ReportSplit</ns0:flowNodeRef>
        <ns0:flowNodeRef>G_MilReport</ns0:flowNodeRef>
        <ns0:flowNodeRef>G_AgrSignSplit</ns0:flowNodeRef>
        <ns0:flowNodeRef>G_AgrSignJoin</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_Readiness</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_Close</ns0:flowNodeRef>
        <ns0:flowNodeRef>G_ParJoin</ns0:flowNodeRef>
        <ns0:flowNodeRef>E_Day</ns0:flowNodeRef>
        <ns0:flowNodeRef>G_DayJoin</ns0:flowNodeRef>
        <ns0:flowNodeRef>End</ns0:flowNodeRef>
        <ns0:flowNodeRef>G_ReportJoin</ns0:flowNodeRef>
        <ns0:flowNodeRef>G_MilReportMerge</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_0114n8h</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_1" name="Сотрудник">
        <ns0:flowNodeRef>T_SignAgrEmployee</ns0:flowNodeRef>
      </ns0:lane>
    </ns0:laneSet>
    <ns0:startEvent id="Start" name="Возникло основание для прекращения трудового договора" />
    <ns0:userTask id="T_Class" name="Определить основание и применимую процедуру увольнения">
      <ns0:dataOutputAssociation id="DataOutputAssociation_0bl3gxe">
        <ns0:targetRef>SR_1C_Class</ns0:targetRef>
      </ns0:dataOutputAssociation>
    </ns0:userTask>
    <ns0:exclusiveGateway id="G_Basis" name="Основание увольнения?" />
    <ns0:sequenceFlow id="F1" sourceRef="Start" targetRef="T_Class" />
    <ns0:sequenceFlow id="F2" sourceRef="T_Class" targetRef="G_Basis" />
    <ns0:userTask id="T_App" name="Получить собственноручно подписанное заявление сотрудника" />
    <ns0:userTask id="T_Date" name="Определить дату увольнения с учетом срока предупреждения" />
    <ns0:exclusiveGateway id="G_Early" name="Требуется согласование более ранней даты?" />
    <ns0:userTask id="T_EarlyDoc" name="Сформировать согласование увольнения до истечения срока предупреждения" />
    <ns0:userTask id="T_EarlyDecision" name="Согласовать / не согласовать раннюю дату увольнения" />
    <ns0:exclusiveGateway id="G_EarlyOk" name="Дата согласована?" />
    <ns0:userTask id="T_DateStd" name="Зафиксировать дату с учетом срока предупреждения" />
    <ns0:userTask id="T_DateEarly" name="Зафиксировать согласованную дату увольнения" />
    <ns0:sequenceFlow id="F3" name="По собственному желанию" sourceRef="G_Basis" targetRef="T_App" />
    <ns0:sequenceFlow id="F4" sourceRef="T_App" targetRef="T_Date" />
    <ns0:sequenceFlow id="F5" sourceRef="T_Date" targetRef="G_Early" />
    <ns0:sequenceFlow id="F6" name="Да" sourceRef="G_Early" targetRef="T_EarlyDoc" />
    <ns0:sequenceFlow id="F7" sourceRef="T_EarlyDoc" targetRef="T_EarlyDecision" />
    <ns0:sequenceFlow id="F8" sourceRef="T_EarlyDecision" targetRef="G_EarlyOk" />
    <ns0:sequenceFlow id="F9" name="Да" sourceRef="G_EarlyOk" targetRef="T_DateEarly" />
    <ns0:sequenceFlow id="F10" name="Нет" sourceRef="G_EarlyOk" targetRef="T_DateStd" />
    <ns0:sequenceFlow id="F11" name="Нет" sourceRef="G_Early" targetRef="T_DateStd" />
    <ns0:userTask id="T_Proposal" name="Получить / сформировать предложение о прекращении договора по соглашению сторон" />
    <ns0:userTask id="T_Agreement" name="Подготовить соглашение о расторжении трудового договора" />
    <ns0:userTask id="T_SignAgr" name="Подписать соглашение со стороны работодателя" />
    <ns0:exclusiveGateway id="G_AgrSigned" name="Соглашение подписано обеими сторонами?" />
    <ns0:endEvent id="End_NoAgr" name="Прекращение по соглашению сторон не состоялось" />
    <ns0:sequenceFlow id="F12" name="Соглашение сторон" sourceRef="G_Basis" targetRef="T_Proposal" />
    <ns0:sequenceFlow id="F13" sourceRef="T_Proposal" targetRef="T_Agreement" />
    <ns0:sequenceFlow id="F14" sourceRef="T_Agreement" targetRef="G_AgrSignSplit" />
    <ns0:sequenceFlow id="F15" sourceRef="T_SignAgr" targetRef="G_AgrSignJoin" />
    <ns0:sequenceFlow id="F16" name="Нет" sourceRef="G_AgrSigned" targetRef="End_NoAgr" />
    <ns0:callActivity id="T_Fixed" name="Выполнить процедуру прекращения срочного трудового договора" calledElement="">
      <ns0:outgoing>Flow_1hdxfxh</ns0:outgoing>
    </ns0:callActivity>
    <ns0:callActivity id="T_Employer" name="Выполнить процедуру увольнения по соответствующему основанию работодателя" calledElement="">
      <ns0:incoming>Flow_1hdxfxh</ns0:incoming>
      <ns0:outgoing>Flow_0uwsi8z</ns0:outgoing>
    </ns0:callActivity>
    <ns0:callActivity id="T_Other" name="Выполнить процедуру по иному основанию прекращения договора" calledElement="" />
    <ns0:sequenceFlow id="F17" name="Истечение срока" sourceRef="G_Basis" targetRef="T_Fixed" />
    <ns0:sequenceFlow id="F18" name="Инициатива работодателя" sourceRef="G_Basis" targetRef="T_Employer" />
    <ns0:sequenceFlow id="F19" name="Иное основание" sourceRef="G_Basis" targetRef="T_Other" />
    <ns0:exclusiveGateway id="G_DateFixed" name="Дата увольнения документально определена">
      <ns0:incoming>Flow_0uwsi8z</ns0:incoming>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="F20" sourceRef="T_DateEarly" targetRef="G_DateFixed" />
    <ns0:sequenceFlow id="F21" sourceRef="T_DateStd" targetRef="G_DateFixed" />
    <ns0:sequenceFlow id="F22" name="Да" sourceRef="G_AgrSigned" targetRef="G_DateFixed" />
    <ns0:sequenceFlow id="F25" sourceRef="T_Other" targetRef="G_DateFixed" />
    <ns0:userTask id="T_Control" name="Зафиксировать контрольную дату, сформировать задания и передать расчетные кадровые сведения">
      <ns0:dataOutputAssociation id="DataOutputAssociation_01ojgzj">
        <ns0:targetRef>DO_MgrRef</ns0:targetRef>
      </ns0:dataOutputAssociation>
      <ns0:dataOutputAssociation id="DataOutputAssociation_0mcl0v1">
        <ns0:targetRef>DO_AccRef</ns0:targetRef>
      </ns0:dataOutputAssociation>
      <ns0:dataOutputAssociation id="DataOutputAssociation_1gwobmn">
        <ns0:targetRef>DO_ITRef</ns0:targetRef>
      </ns0:dataOutputAssociation>
      <ns0:dataOutputAssociation id="DataOutputAssociation_0gnmsu5">
        <ns0:targetRef>DO_MilRef</ns0:targetRef>
      </ns0:dataOutputAssociation>
    </ns0:userTask>
    <ns0:sequenceFlow id="F26" sourceRef="G_DateFixed" targetRef="T_Control" />
    <ns0:parallelGateway id="G_ParSplit" name="Запустить параллельную подготовку" />
    <ns0:sequenceFlow id="F27" sourceRef="T_Control" targetRef="G_ParSplit" />
    <ns0:userTask id="T_Manager" name="Организовать передачу дел, задач и возврат имущества по реестру" />
    <ns0:userTask id="T_Account" name="Подготовить окончательный расчет" />
    <ns0:userTask id="T_ITPrep" name="Определить по реестру ИТ-доступы и подготовить их прекращение" />
    <ns0:exclusiveGateway id="G_Mil" name="Сотрудник подлежит воинскому учету?" />
    <ns0:userTask id="T_MilPrep" name="Подготовить сведения об увольнении по воинскому учету" />
    <ns0:userTask id="T_Order" name="Подготовить проект приказа и комплект документов" />
    <ns0:sequenceFlow id="F28" sourceRef="G_ParSplit" targetRef="T_Manager" />
    <ns0:sequenceFlow id="F29" sourceRef="G_ParSplit" targetRef="T_Account" />
    <ns0:sequenceFlow id="F30" sourceRef="G_ParSplit" targetRef="T_ITPrep" />
    <ns0:sequenceFlow id="F31" sourceRef="G_ParSplit" targetRef="G_Mil" />
    <ns0:sequenceFlow id="F32" sourceRef="G_ParSplit" targetRef="T_Order" />
    <ns0:parallelGateway id="G_ParJoin" name="Подготовительные действия завершены" />
    <ns0:sequenceFlow id="F33" sourceRef="T_Manager" targetRef="G_ParJoin" />
    <ns0:sequenceFlow id="F34" sourceRef="T_Account" targetRef="G_ParJoin" />
    <ns0:sequenceFlow id="F35" sourceRef="T_ITPrep" targetRef="G_ParJoin" />
    <ns0:sequenceFlow id="F36" name="Нет" sourceRef="G_Mil" targetRef="Gateway_0114n8h" />
    <ns0:sequenceFlow id="F37" name="Да" sourceRef="G_Mil" targetRef="T_MilPrep" />
    <ns0:sequenceFlow id="F38" sourceRef="T_MilPrep" targetRef="Gateway_0114n8h" />
    <ns0:userTask id="T_HRCheck" name="Проверить комплект документов и проект приказа" />
    <ns0:exclusiveGateway id="G_DocsOk" name="Документы корректны?" />
    <ns0:sequenceFlow id="F39" sourceRef="T_Order" targetRef="T_HRCheck" />
    <ns0:sequenceFlow id="F40" sourceRef="T_HRCheck" targetRef="G_DocsOk" />
    <ns0:sequenceFlow id="F41" name="Нет" sourceRef="G_DocsOk" targetRef="T_Order" />
    <ns0:sequenceFlow id="F42" name="Да" sourceRef="G_DocsOk" targetRef="G_ParJoin" />
    <ns0:userTask id="T_SignOrder" name="Подписать приказ о прекращении трудового договора" />
    <ns0:userTask id="T_ZUP" name="Оформить увольнение в 1С:ЗУП" />
    <ns0:sequenceFlow id="F43" sourceRef="G_ParJoin" targetRef="T_Readiness" />
    <ns0:sequenceFlow id="F44" sourceRef="T_SignOrder" targetRef="T_ZUP" />
    <ns0:intermediateCatchEvent id="E_Day" name="Наступила дата увольнения">
      <ns0:timerEventDefinition id="Timer_Day" />
    </ns0:intermediateCatchEvent>
    <ns0:sequenceFlow id="F45" sourceRef="T_ZUP" targetRef="E_Day" />
    <ns0:parallelGateway id="G_DaySplit" name="Выполнить действия в день увольнения" />
    <ns0:sequenceFlow id="F46" sourceRef="E_Day" targetRef="G_DaySplit" />
    <ns0:userTask id="T_EmployeeDocs" name="Ознакомить сотрудника с приказом и выдать обязательные документы" />
    <ns0:userTask id="T_Pay" name="Произвести окончательный расчет" />
    <ns0:userTask id="T_ITBlock" name="Заблокировать учетные записи, прекратить доступы и отозвать АРМ" />
    <ns0:sequenceFlow id="F47" sourceRef="G_DaySplit" targetRef="T_EmployeeDocs" />
    <ns0:sequenceFlow id="F48" sourceRef="G_DaySplit" targetRef="T_Pay" />
    <ns0:parallelGateway id="G_DayJoin" name="Действия в день увольнения завершены" />
    <ns0:sequenceFlow id="F50" sourceRef="T_EmployeeDocs" targetRef="G_DayJoin" />
    <ns0:sequenceFlow id="F51" sourceRef="T_Pay" targetRef="G_DayJoin" />
    <ns0:sequenceFlow id="F52" sourceRef="G_DayJoin" targetRef="T_ITBlock" />
    <ns0:parallelGateway id="G_ReportSplit" name="Завершить действия после увольнения" />
    <ns0:sequenceFlow id="F53" sourceRef="T_ITBlock" targetRef="G_ReportSplit" />
    <ns0:userTask id="T_SFR" name="Сформировать и направить сведения в СФР" />
    <ns0:exclusiveGateway id="G_MilReport" name="Требуется направление сведений по воинскому учету?" />
    <ns0:userTask id="T_MilSend" name="Направить сведения по воинскому учету" />
    <ns0:sequenceFlow id="F54" sourceRef="G_ReportSplit" targetRef="T_SFR" />
    <ns0:sequenceFlow id="F55" sourceRef="G_ReportSplit" targetRef="G_MilReport" />
    <ns0:parallelGateway id="G_ReportJoin" name="Отчетность выполнена">
      <ns0:incoming>F56</ns0:incoming>
    </ns0:parallelGateway>
    <ns0:sequenceFlow id="F56" sourceRef="T_SFR" targetRef="G_ReportJoin" />
    <ns0:sequenceFlow id="F57" name="Нет" sourceRef="G_MilReport" targetRef="G_MilReportMerge" />
    <ns0:sequenceFlow id="F58" name="Да" sourceRef="G_MilReport" targetRef="T_MilSend" />
    <ns0:sequenceFlow id="F59" sourceRef="T_MilSend" targetRef="G_MilReportMerge" />
    <ns0:userTask id="T_Close" name="Закрыть процесс увольнения и передать кадровые документы на хранение" />
    <ns0:endEvent id="End" name="Увольнение оформлено" />
    <ns0:sequenceFlow id="F60" sourceRef="G_ReportJoin" targetRef="T_Close" />
    <ns0:sequenceFlow id="F61" sourceRef="T_Close" targetRef="End" />
    <ns0:dataObject id="DO_Early" name="Согласование ранней даты увольнения" />
    <ns0:dataObjectReference id="DO_EarlyRef" name="Согласование ранней даты увольнения" dataObjectRef="DO_Early" />
    <ns0:dataObject id="DO_Proposal" name="Предложение по соглашению сторон" />
    <ns0:dataObjectReference id="DO_ProposalRef" name="Предложение по соглашению сторон" dataObjectRef="DO_Proposal" />
    <ns0:dataObject id="DO_Agr" name="Соглашение о расторжении трудового договора" />
    <ns0:dataObjectReference id="DO_AgrRef" name="Соглашение о расторжении трудового договора" dataObjectRef="DO_Agr" />
    <ns0:dataObject id="DO_Mgr" name="Задание руководителю" />
    <ns0:dataObjectReference id="DO_MgrRef" name="Задание руководителю" dataObjectRef="DO_Mgr" />
    <ns0:dataObject id="DO_Acc" name="Задание бухгалтерии" />
    <ns0:dataObjectReference id="DO_AccRef" name="Задание бухгалтерии" dataObjectRef="DO_Acc" />
    <ns0:dataObject id="DO_IT" name="Задание ИТ" />
    <ns0:dataObjectReference id="DO_ITRef" name="Задание ИТ" dataObjectRef="DO_IT" />
    <ns0:dataObject id="DO_Mil" name="Задание по воинскому учету" />
    <ns0:dataObjectReference id="DO_MilRef" name="Задание по воинскому учету" dataObjectRef="DO_Mil" />
    <ns0:userTask id="T_SignAgrEmployee" name="Подписать соглашение со стороны сотрудника" />
    <ns0:parallelGateway id="G_AgrSignSplit" name="Передать соглашение на подписание сторонам" />
    <ns0:parallelGateway id="G_AgrSignJoin" name="Подписание сторонами завершено" />
    <ns0:sequenceFlow id="F62" sourceRef="G_AgrSignSplit" targetRef="T_SignAgr" />
    <ns0:sequenceFlow id="F63" sourceRef="G_AgrSignSplit" targetRef="T_SignAgrEmployee" />
    <ns0:sequenceFlow id="F64" sourceRef="T_SignAgrEmployee" targetRef="G_AgrSignJoin" />
    <ns0:sequenceFlow id="F65" sourceRef="G_AgrSignJoin" targetRef="G_AgrSigned" />
    <ns0:dataObjectReference id="DO_EarlyRef_Decision" name="Согласование увольнения до истечения срока предупреждения" dataObjectRef="DO_Early" />
    <ns0:dataObjectReference id="DO_AgrRef_Employee" name="Соглашение о расторжении трудового договора" dataObjectRef="DO_Agr" />
    <ns0:dataObjectReference id="DO_AgrRef_Employer" name="Соглашение о расторжении трудового договора" dataObjectRef="DO_Agr" />
    <ns0:dataObjectReference id="DO_MgrRef_Exec" name="Задание руководителю" dataObjectRef="DO_Mgr" />
    <ns0:dataObjectReference id="DO_AccRef_Exec" name="Задание бухгалтерии" dataObjectRef="DO_Acc" />
    <ns0:dataObjectReference id="DO_ITRef_Exec" name="Задание ИТ" dataObjectRef="DO_IT" />
    <ns0:dataObjectReference id="DO_MilRef_Exec" name="Задание по воинскому учету" dataObjectRef="DO_Mil" />
    <ns0:sequenceFlow id="F67" sourceRef="Gateway_0114n8h" targetRef="G_ParJoin" />
    <ns0:exclusiveGateway id="G_MilReportMerge" name="Отчетность по воинскому учету завершена" />
    <ns0:sequenceFlow id="F70" sourceRef="G_MilReportMerge" targetRef="G_ReportJoin" />
    <ns0:userTask id="T_Readiness" name="Проверить готовность заданий и документов к дате увольнения" />
    <ns0:sequenceFlow id="F66" sourceRef="T_Readiness" targetRef="T_SignOrder" />
    <ns0:userTask id="T_ManagerConfirm" name="Подтвердить передачу дел, имущества и незавершенных задач" />
    <ns0:sequenceFlow id="F68" sourceRef="G_ReportSplit" targetRef="T_ManagerConfirm" />
    <ns0:sequenceFlow id="F69" sourceRef="T_ManagerConfirm" targetRef="G_ReportJoin" />
    <ns0:dataStoreReference id="SR_1C_Class" name="1С:ЗУП" dataStoreRef="DS_1C" />
    <ns0:dataStoreReference id="SR_1C_ZUP" name="1С:ЗУП" dataStoreRef="DS_1C" />
    <ns0:sequenceFlow id="Flow_0uwsi8z" sourceRef="T_Employer" targetRef="G_DateFixed" />
    <ns0:sequenceFlow id="Flow_1hdxfxh" sourceRef="T_Fixed" targetRef="T_Employer" />
    <ns0:parallelGateway id="Gateway_0114n8h" name="Подготовка по воинскому учету завершена">
      <ns0:incoming>F38</ns0:incoming>
      <ns0:incoming>F36</ns0:incoming>
      <ns0:outgoing>F67</ns0:outgoing>
    </ns0:parallelGateway>
    <ns0:association id="A2" associationDirection="One" sourceRef="T_EarlyDoc" targetRef="DO_EarlyRef" />
    <ns0:association id="A3" associationDirection="One" sourceRef="T_Proposal" targetRef="DO_ProposalRef" />
    <ns0:association id="A4" associationDirection="One" sourceRef="T_Agreement" targetRef="DO_AgrRef" />
    <ns0:association id="A10" associationDirection="One" sourceRef="DO_EarlyRef_Decision" targetRef="T_EarlyDecision" />
