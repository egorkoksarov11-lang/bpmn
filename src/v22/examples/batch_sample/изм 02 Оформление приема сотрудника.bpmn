      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Принят оффер" />
    <bpmn:userTask id="a" name="5.1 Проверить комплект документов и условия по офферу" />
    <bpmn:exclusiveGateway id="g1" name="Комплект полный?" />
    <bpmn:userTask id="b" name="Предоставить недостающие документы" />
    <bpmn:exclusiveGateway id="g2" name="Дата выхода изменилась?" />
    <bpmn:userTask id="c" name="5.2 Подтвердить новую дату выхода" />
    <bpmn:userTask id="d" name="5.3 Ознакомить с должностной инструкцией и обязательными ЛНА" />
    <bpmn:userTask id="e" name="Ознакомиться под подпись" />
    <bpmn:userTask id="f" name="5.4 Сформировать трудовой договор" />
    <bpmn:userTask id="t1" name="Сформировать должностную инструкцию / подготовить актуальную редакцию" />
    <bpmn:userTask id="t2" name="Сформировать приказ о приеме по форме Т-1" />
    <bpmn:userTask id="t3" name="5.10 Сформировать перечень переданных документов и направить комплект на проверку">
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0mkkjh6">
        <bpmn:targetRef>DOR_Checklist</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="t4" name="Проверить трудовой договор, должностную инструкцию, Т-1 и приложения" />
    <bpmn:exclusiveGateway id="g3" name="Есть замечания?" />
    <bpmn:userTask id="t5" name="Устранить замечания и обновить комплект" />
    <bpmn:userTask id="t6" name="Отметить согласование комплекта" />
    <bpmn:userTask id="t7" name="Передать согласованный комплект на подписание" />
    <bpmn:userTask id="t8" name="Подписать трудовой договор, должностную инструкцию / утверждение и приказ Т-1" />
    <bpmn:userTask id="t9" name="Подписать трудовой договор и ознакомиться с приказом Т-1" />
    <bpmn:userTask id="i" name="Внести сведения о физическом лице в 1С:ЗУП">
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1vf22l5">
        <bpmn:targetRef>DSR_1C</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="j" name="Оформить прием в 1С:ЗУП">
      <bpmn:dataOutputAssociation id="DataOutputAssociation_08npezk">
        <bpmn:targetRef>DataStoreReference_13k8dzb</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g4" name="Есть обязанность воинского учета?" />
    <bpmn:callActivity id="k" name="Воинский учет" calledElement="MilitaryAccounting" />
    <bpmn:userTask id="l" name="Сформировать сведения для СФР">
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0isd3is">
        <bpmn:targetRef>DataStoreReference_0038d3m</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="m" name="Отправить сведения в СФР" />
    <bpmn:exclusiveGateway id="g5" name="Принято без ошибок?" />
    <bpmn:userTask id="n" name="Исправить сведения">
      <bpmn:dataOutputAssociation id="DataOutputAssociation_14xv094">
        <bpmn:targetRef>DSR_1C_SFR</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="o" name="Сформировать кадровый комплект сотрудника" />
    <bpmn:endEvent id="end" name="Прием оформлен" />
    <bpmn:exclusiveGateway id="gOffer" name="Условия соответствуют офферу?" />
    <bpmn:receiveTask id="waitOffer" name="Ожидать устранения расхождения условий с оффером" />
