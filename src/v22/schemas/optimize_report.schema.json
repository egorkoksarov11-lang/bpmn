{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"BPMN v22 Optimization Report",
  "type":"object",
  "required":["engine_version","status","source","output","preflight","semantic_check","geometry_before","geometry_after","artifacts"],
  "properties":{
    "engine_version":{"type":"string"},
    "status":{"const":"passed"},
    "source":{"type":"string"},
    "output":{"type":"string"},
    "preflight":{"type":"object"},
    "semantic_check":{"type":"object","required":["passed","mode"],"properties":{"passed":{"const":true},"mode":{"type":"string"}}},
    "geometry_before":{"type":"object"},
    "geometry_after":{"type":"object"},
    "removed_redundant_associations":{"type":"array","items":{"type":"string"}},
    "artifacts":{"type":"object"}
  }
}
